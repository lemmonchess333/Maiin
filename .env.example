# Firebase Configuration
# Create a Firebase project at https://console.firebase.google.com
# Then copy your config values here

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000:web:000

# Firebase Analytics measurement ID (e.g. G-XXXXXXXXXX). Optional —
# when unset the analytics layer stays a no-op (events route only to the
# dev logger), so leaving it blank disables third-party delivery entirely.
# Find it in Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_MEASUREMENT_ID=

# FCM Web push public VAPID key. Public by design (it ships in the client
# bundle); it is a GitHub Actions secret only to match the other VITE_ vars.
# Firebase console → Project settings → Cloud Messaging → Web Push
# certificates. Unset → web push registration is skipped. Native push is
# APNs and does not read this.
VITE_FIREBASE_VAPID_KEY=

# Set to "true" to use Firebase emulators in development
VITE_USE_EMULATORS=false

# Firebase App Check — reCAPTCHA v3 (web).
#   1. Register a site at https://www.google.com/recaptcha/admin (v3)
#      with domains: lemmonchess333.github.io, troposfit.com, localhost
#   2. Paste the site key below AND into Firebase console →
#      App Check → Web → reCAPTCHA v3 provider
#   3. Enable enforcement per-service (Firestore → Storage → Functions)
#      in the Firebase console once clients are reliably sending tokens.
VITE_RECAPTCHA_V3_SITE_KEY=

# App Check debug token for local development. Copy from the Firebase
# console (Project Settings → App Check → Debug tokens) after the first
# `initializeAppCheck` call prints a debug token to the console.
VITE_APP_CHECK_DEBUG_TOKEN=

# RevenueCat (iOS in-app purchases — ADR-0006)
# The RC public SDK key (appl_...), from RevenueCat → Project → API keys.
# Read by src/lib/revenuecat.ts since slice 2, and undeclared here until
# now. LEAVE IT UNSET until the backend is live: purchaseProvider routes
# iOS through RevenueCat the moment it is present, and the entitlement
# only lands if REVENUECAT_WEBHOOK_AUTH and REVENUECAT_REST_KEY are
# provisioned in Secret Manager AND revenueCatWebhook is deployed and
# registered in the RevenueCat dashboard. Set it before those and a
# purchase is taken and nothing is granted. The activation order is in
# docs/iap/revenuecat-setup.md. Server-side secrets never belong in a
# VITE_ var — they ship in the client bundle.
VITE_REVENUECAT_IOS_KEY=

# Stripe Configuration (for Pro subscriptions)
VITE_STRIPE_MONTHLY_PRICE_ID=price_monthly
VITE_STRIPE_YEARLY_PRICE_ID=price_yearly
VITE_STRIPE_CHECKOUT_URL=/api/create-checkout-session

# There is no VITE_STRIPE_LIFETIME_PRICE_ID. One was listed here and read
# by nothing: PlanId is monthly | yearly, and the lifetime entitlement is
# purely server-side (STRIPE_PRICE_ID_LIFETIME in the functions env, and
# the planKind === "lifetime" branch that protects those buyers from a
# subscription downgrade). Listing a client var for it invited someone to
# set it and wonder why no lifetime plan appeared.

# Admin allowlist for the /admin/moderation route — comma-separated uids.
# The route gate is UX only; listPendingReports re-checks the server-side
# ADMIN_UIDS, so an empty value here hides the queue rather than opening
# it. It was missing from this file AND from every deploy workflow, which
# is why the moderation queue was unreachable in every deployed build.
# Keep in step with the functions-side ADMIN_UIDS (a plain env var, not a
# Secret Manager secret).
VITE_ADMIN_UIDS=

# Road-aware route planning (Pro-gated Mapbox road-align / loop layer in
# RoutePlannerSheet). "true" to enable; the production deploys set it.
# Requires the planRunningRoute callable and its MAPBOX_DIRECTIONS_TOKEN.
VITE_ROUTE_PLANNING_ENABLED=false

# ──────────────────────────────────────────────────────────────────
# Server-side secrets — NOT loaded by Vite, listed here for reference.
# Set via `firebase functions:secrets:set` (Secret Manager). The old
# `functions:config:set` form throws: firebase-functions v7 dropped
# functions.config() when the Cloud Runtime Config API shut down.
# `cd functions && npm run secrets:check` reads the source and prints the
# exact command for every secret the code actually binds.
# ──────────────────────────────────────────────────────────────────
# APPLE_KEY_ID      — App Store Connect → Users and Access → Keys → IAP
# APPLE_ISSUER_ID   — Same page; above the key list
# APPLE_PRIVATE_KEY — Contents of AuthKey_*.p8 (newlines as \n)
# STRIPE_SECRET_KEY — Stripe dashboard → Developers → API keys
#   (these four were written in the dotted `apple.key_id` form, which was
#   the functions.config() namespace, not the Secret Manager name the code
#   now binds — copying them verbatim provisioned four secrets nothing reads)
# STRIPE_RETURN_URL_ORIGINS — optional comma-separated allowlist for
#   Checkout success/cancel redirects. Defaults to GitHub Pages,
#   troposfit.com, localhost, and 127.0.0.1 preview/dev origins.
# PUBLIC_APP_BASE_URL — origin+basepath the server uses to synthesise
#   Stripe Checkout return URLs. Example: https://troposfit.com/ or
#   https://lemmonchess333.github.io/Maiin/. Defaults to the GitHub
#   Pages origin in production, http://localhost:4173/Maiin/ under
#   FUNCTIONS_EMULATOR=true. The trailing slash is normalised in if
#   you leave it off.
