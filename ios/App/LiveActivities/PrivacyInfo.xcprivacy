<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Live Activity widget's own manifest: a privacy manifest covers
	     the bundle it is in, and the widget is a bundle inside the app.
	     It collects nothing and reaches no network: it draws what the app
	     hands the activity. The app's manifest (ios/App/App/PrivacyInfo.xcprivacy)
	     declares what Tropos collects. Pinned by
	     src/lib/__tests__/iosPrivacyDeclarations.test.ts. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults. 1C8F.1: capacitor-live-activities' LiveActivitiesKit,
		     linked into the widget for its attributes type, carries the App
		     Group defaults it shares with the app (SharedDataManager), as the
		     app's manifest declares for the plugin. The widget's own code
		     reads no defaults. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
