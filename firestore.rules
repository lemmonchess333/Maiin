rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // Default: deny all reads and writes
    // Last deployed: 2026-03-19 — touch to trigger CI deploy
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================
    // User profiles — owner-only access
    // H1: subscriptionTier, stripeCustomerId, stripeSubscriptionId
    //     are protected from client-side writes
    // ========================================
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ========================================
    // R1A-Deletion write-freeze
    //
    // While accountDeletionRequests/{uid}.status is in the active set
    // (running / failed_cleanup / pending_cleanup / pending_auth_deletion /
    // operator_review), the user cannot create or update normal app data.
    // Reads remain allowed so the client can render UI during deletion.
    //
    // Status values exempt from the freeze (writes still allowed):
    //   - 'requested': lock not yet acquired by the executor
    //   - 'completed': cascade finished
    //   - 'cancelled': user backed out (the cancel callable bypasses
    //                  this freeze for the single status-write that
    //                  transitions out of the active set)
    //
    // Cost: each isDeleting() call performs one exists() + one get()
    // against accountDeletionRequests/{uid} — 2 of the 10-read
    // per-evaluation budget. Acceptable; the rule is applied at the
    // single write-rule level per match block.
    //
    // The Admin SDK bypasses these rules entirely, so the deletion
    // executor (deleteMyAccount + cancelDeletionRequest) still operates
    // normally during the freeze.
    // ========================================
    function isDeleting(uid) {
      let path = /databases/$(database)/documents/accountDeletionRequests/$(uid);
      return exists(path)
        && get(path).data.status in [
          'running',
          'failed_cleanup',
          'pending_cleanup',
          'pending_auth_deletion',
          'operator_review'
        ];
    }

    // A server-owned tombstone (deletedAccounts/{uid}) outlives the deleted
    // Auth session (~90-day TTL). It exists specifically to cover the window
    // after a deletion COMPLETES in which an already-issued ID token can
    // still authenticate. Rules may consult a document whose own read/write
    // rules deny clients — get()/exists() inside rule evaluation bypasses
    // those. Existence is the contract here: a single exists() (no get())
    // keeps the read budget low, and a delayed TTL cleanup fails CLOSED
    // (writes stay frozen) rather than reopening writes.
    function isTombstoned(uid) {
      return exists(
        /databases/$(database)/documents/deletedAccounts/$(uid)
      );
    }

    // Full writable-account contract: an account is write-frozen while its
    // deletion is in progress OR after it has completed (live tombstone).
    function isWriteFrozen(uid) {
      return isDeleting(uid) || isTombstoned(uid);
    }

    // Convenience for owner-write paths: caller is the owner AND the
    // account is writable (not mid-deletion, not tombstoned). Legacy name
    // retained because it's used across every owner subcollection;
    // "NotDeleting" now means the full writable-account contract.
    function isOwnerAndNotDeleting(uid) {
      return isOwner(uid) && !isWriteFrozen(uid);
    }

    /* Public content requires a verified email.

       `email_verified` is a standard ID-token claim: OAuth providers
       (Google, Apple) mint it true, an email/password signup carries
       false until the user taps the verification link. Gating on it
       keeps a throwaway unverified address from publishing into other
       people's feeds while costing a verified account nothing.

       Scope is the CONTENT surfaces another user reads — the activity
       feed and space posts here, comments in the two server callables
       that write them. Private logging under users/{uid}/* and every
       non-content interaction (likes, kudos, follows, joins, circle
       events) stay open to unverified accounts: the app must work for
       a brand-new signup before the email arrives. The `in` check makes
       an absent claim a plain false rather than an evaluation error —
       both deny, but the intent reads at the call site. */
    function isEmailVerified() {
      return request.auth != null
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    /* Is there a block in EITHER direction between these two users?

       Blocking severs the follow edges at block time (`blockUser` deletes all
       four docs), but nothing stopped the blocked user simply FOLLOWING
       AGAIN: the follow write is a direct client write, and these rules
       allowed any authenticated user to create `followers/{anyone}/users/
       {self}`. The fan-out reads `followers/{author}`, so a re-follow put the
       author's activities straight back into the blocked user's feed.

       That made blocking bypassable by the blocked party, which is the one
       thing it must not be — client-side feed filtering does not help here,
       because the blocked user's own filter list does not contain the person
       who blocked THEM.

       Both directions are refused: you cannot follow someone who blocked you,
       and you cannot follow someone you blocked (unblock first). Two
       `exists()` reads per follow write — well inside the per-request budget,
       and follows are rare. */
    function blockExistsBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a)/users/$(b))
        || exists(/databases/$(database)/documents/blocks/$(b)/users/$(a));
    }

    /* Who besides its author may read a feed post: anyone signed in for a
       public one; for a followers-only one, a follower of the author when
       neither has blocked the other. A follow edge can outlive a block
       (blockUser's delete of it can fail), so the edge alone is not
       enough. */
    function activityVisibleTo(activity) {
      return activity.visibility == 'public'
        || (
          activity.visibility == 'followers'
          && exists(/databases/$(database)/documents/followers/$(activity.authorId)/users/$(request.auth.uid))
          && !blockExistsBetween(activity.authorId, request.auth.uid)
        );
    }

    /* Has a moderator restricted the signed-in account? (S4e, STATUS
       2026-10-06.)

       `resolveReport` with `restrictUser` writes globalRestrictedUids/{uid}
       and nothing else does. A restriction refuses everything that reaches
       another person and nothing else: publishing, editing or widening a
       post, follows, joining a Space or a challenge, Circle events and
       partner bonds are refused; private logging, the person's own
       profile, reading, blocking, unfollowing, leaving and deleting their
       own things stay open. The callables (props, comments, likes,
       reactions, Circles) hold the same line in functions/lib/restriction.js.

       One exists() on each write it guards. Every caller has already
       required request.auth. */
    function isRestricted() {
      return exists(/databases/$(database)/documents/globalRestrictedUids/$(request.auth.uid));
    }

    /* Does this account approve each follower (Polish2 call 4)? Yes unless
       its owner turned it off: an absent field is the default, so every
       account that never chose approves. A follow opens followers-only
       posts, the default share (S2c), so it waits for the person followed.
       get() reads the owner-only profile document, as rules may; an
       account with no profile document cannot be followed directly. */
    function approvesFollowers(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data
        .get('approveFollowers', true) != false;
    }

    /* The person followed accepting a request: only they write the two
       follow edges for someone who asked, in the batch that deletes the
       request (exists() reads the state before the batch). */
    function acceptsFollowRequest(targetUid, requesterUid) {
      return request.auth != null
        && request.auth.uid == targetUid
        && exists(/databases/$(database)/documents/followRequests/$(targetUid)/users/$(requesterUid))
        && !isWriteFrozen(targetUid)
        && !isWriteFrozen(requesterUid)
        && !blockExistsBetween(targetUid, requesterUid);
    }

    /* What a follow edge holds: when it was made and, from an accepted
       request, that it was one (onFollowerCreated reads `fromRequest` to
       tell the follower). Nothing else. Both edges are readable by anyone
       signed in, and an open shape let a follower park up to a megabyte
       on someone else's followers list, paid for by every reader of it. */
    function isDirectFollowEdge() {
      return request.resource.data.keys().hasOnly(['followedAt'])
        && request.resource.data.followedAt is timestamp;
    }

    function isAcceptedFollowEdge() {
      return request.resource.data.keys().hasOnly(['followedAt', 'fromRequest'])
        && request.resource.data.followedAt is timestamp
        && request.resource.data.fromRequest == true;
    }

    /* approveFollowers is a boolean when present (Settings → Privacy); a
       null, like the other switches', means none chosen: approval on. */
    function approveFollowersValid() {
      return !('approveFollowers' in request.resource.data)
        || request.resource.data.approveFollowers == null
        || request.resource.data.approveFollowers is bool;
    }

    function approveFollowersUnchangedOrValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['approveFollowers'])
        || approveFollowersValid();
    }

    /* Photo URL value gate — shared by every field a client writes that
       ANOTHER user's device will load as an <img src>: the public
       profile avatar, activity and space-post author avatars, and the
       challenge-participant / space-member identity rows. A URL a
       stranger's browser fetches is a tracking pixel with a per-viewer
       IP unless its origin is one Tropos already trusts, and an image
       nobody screened unless it is one of the uploads Tropos screens:
         - THIS project's Firebase Storage bucket, and only its two
           screened folders, profile photos and Space photos
           (lib/photoScreen.js checks every upload there; progress
           photos are never screened). The host alone is not enough:
           every Firebase project serves from firebasestorage.googleapis
           .com, so a URL into an attacker's own bucket would pass, and
           its access logs carry every viewer's IP. Both default bucket names
           a project can have are listed; each is reserved to this
           project. After /o/ the object name must be one path segment,
           with no '/', '\\', '?' or '#' before the query: a browser
           resolves '../' before it fetches, so '/o/../../other-bucket/'
           would load from another project. A real download URL encodes
           every slash in the object name as %2F.
         - Google's account photos (lh3.googleusercontent.com/a/ and
           /a-/), the avatar a Google sign-in gives. The same host serves
           shared Google Photos and Drive files, so only the account
           photo path is taken, as one segment with no '%' that could
           encode a slash.
         - Apple's CDN (appleid.cdn-apple.com), which serves only Apple's
           own files.
       `https` only and anchored with `^`, so a downgrade or a
       suffix-phishing host (lh3.googleusercontent.com.evil.com) fails;
       capped at 2048 chars so the field cannot carry a payload.
       Null-safe: the type check runs first and `&&` short-circuits, so
       a null never reaches `.matches()` (which would be an evaluation
       error, not false). Whether absent / null / '' are legal is each
       caller's decision — this speaks only to a present value.
       functions/lib/publicPhotoUrl.js gives the server the same answer,
       and its test reads these patterns. */
    function isAllowedPhotoUrl(v) {
      return v is string
        && v.size() <= 2048
        && (
          v.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/adaptive-fitness-af8bb\\.(firebasestorage\\.app|appspot\\.com)/o/(profile-photos|space-photos)%2F[^/\\\\?#]+([?#].*)?$')
          || v.matches('^https://lh3\\.googleusercontent\\.com/a-?/[^/\\\\?#%]+$')
          || v.matches('^https://appleid\\.cdn-apple\\.com/.*')
        );
    }

    /* A photo field a write leaves as it is passes unchecked: a stored
       URL the gate above refuses must not block a merge that touches
       only other fields (the streak mirror, a name, the race toggle).
       A new or changed value is always checked. */
    function photoUnchanged(field) {
      return resource != null
        && field in resource.data
        && request.resource.data[field] == resource.data[field];
    }

    /* A Space post's attached photo: the author's own upload under
       space-photos/{uid}/ in this project's bucket, which is the only
       place the composer puts one (src/lib/spacePhotoUpload.ts) and
       which the photo screen checks. No avatar host qualifies. */
    function isOwnSpacePhotoUrl(v) {
      return v is string
        && v.size() <= 2048
        && v.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/adaptive-fitness-af8bb\\.(firebasestorage\\.app|appspot\\.com)/o/space-photos%2F' + request.auth.uid + '%2F[^/\\\\?#]+([?#].*)?$');
    }

    /* raceGoal value gate — the shape the app actually consumes.
       `allowedUserFields()` gates key NAMES only, so before this the field
       could hold any map at all: `raceGoal: { anything: <...> }` was a legal
       client write. That matters because `raceGoal.distance` indexes
       RACE_CONFIGS in the run scheduler and both server sweeps
       (dailyRaceReconciliationSweep, raceDayCompletion) read the same map —
       an unknown distance resolves to `undefined` and throws.

       DEFENCE IN DEPTH, not a fix for a live path. Every legitimate write of
       this field today goes through a Cloud Function — `configurePlan` for
       the editor, the `skipRecoveryEarly` command for the recovery exit —
       and those run the Admin SDK (rules bypassed) after
       functions/profileSanitizer.js has already validated the same shape.
       What this closes is the direct-SDK path available to any authenticated
       user against their own document. Blast radius there was self-inflicted
       and contained (sweepActiveUsers isolates per-uid), which is why this is
       a small gate rather than a migration.

       Kept as a value gate rather than dropping `raceGoal` from
       `allowedUserFields()`: removal would close the hole outright, but a
       field absent from that list fails as a SILENT permission-denied, and
       this repo has shipped that bug at least three times (hideWeightNumber,
       timezone, goalWeightKg — each rejected every save until spotted). A
       gate keeps a future client writer working as long as it writes the
       real shape. Mirrors the `trainingForSpaceId` gate below, and the
       vocabulary mirrors profileSanitizer.js's `raceGoal` cleaner. */
    function raceGoalValid() {
      let g = request.resource.data.raceGoal;
      return !('raceGoal' in request.resource.data)
        // Run9 3a-ii: `null` is the explicit "no race" value that clears a
        // prior goal on a freeform switch / recovery exit. Must stay legal.
        || g == null
        || (
          g is map
          && g.keys().hasAll(['distance', 'targetDate'])
          && g.keys().hasOnly(['distance', 'targetDate', 'eventName', 'eventSpaceId'])
          && g.distance in ['5k', '10k', 'half', 'marathon']
          // Local "YYYY-MM-DD". Pinned by pattern, not just length: the whole
          // race plan is derived from parsing this, and a 10-character
          // non-date is the same crash as a bad distance.
          && g.targetDate is string
          && g.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (
            !('eventName' in g)
            || (g.eventName is string && g.eventName.size() <= 60)
          )
          && (
            !('eventSpaceId' in g)
            || (g.eventSpaceId is string && isKnownSpaceId(g.eventSpaceId))
          )
        );
    }

    /* Validate only when the field is actually CHANGING.
       On update `request.resource.data` is the full post-write document, so
       gating it unconditionally would let a pre-existing malformed raceGoal —
       exactly what the ungated window allowed — block every unrelated profile
       write that user ever makes again. Locking someone out of their own
       settings to punish a bad value written under the old rule is a worse
       outcome than the value. Writes are gated; stored history is not. */
    function raceGoalUnchangedOrValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['raceGoal'])
        || raceGoalValid();
    }

    /* shareDefaults value gate — who sees a finished session, per type:
       the answer to "Share sessions automatically?", which the finish
       screen acts on without asking again. The client writes one field
       path per type (`shareDefaults.run`), so on update this reads the
       whole map as it will be. Only the two session types; each is one of
       the three answers, or null for "Ask" (the next finish asks). A
       whole-field null means no answer for either type. Same vocabulary as
       profileSanitizer.js and `ShareDefaults` in src/lib/shareDefaults.ts.
       Gated only when the field changes, like raceGoal above, so a bad
       stored map cannot lock a user out of unrelated settings. */
    function shareDefaultsValid() {
      let d = request.resource.data.shareDefaults;
      return !('shareDefaults' in request.resource.data)
        || d == null
        || (
          d is map
          && d.keys().hasOnly(['run', 'workout'])
          && (
            !('run' in d)
            || d.run == null
            || d.run in ['followers', 'public', 'never']
          )
          && (
            !('workout' in d)
            || d.workout == null
            || d.workout in ['followers', 'public', 'never']
          )
        );
    }

    function shareDefaultsUnchangedOrValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['shareDefaults'])
        || shareDefaultsValid();
    }

    /* notificationPreferences value gate — the switches under Settings →
       Notifications → Activity (S3). createNotification reads this map and
       writes nothing for a kind that is off. Only the six switches, each
       a boolean; a whole-field null means none chosen (the defaults
       apply). Same keys as functions/lib/notificationPreferences.js and
       src/lib/notificationPreferences.ts (pinned by
       notificationPreferences.cross.test.ts). Gated only when the field
       changes, like shareDefaults above. */
    function notificationPreferencesValid() {
      let p = request.resource.data.notificationPreferences;
      return !('notificationPreferences' in request.resource.data)
        || p == null
        || (
          p is map
          && p.keys().hasOnly(['kudos', 'comments', 'follows', 'followRequests', 'circles', 'spaces'])
          && (!('kudos' in p) || p.kudos is bool)
          && (!('comments' in p) || p.comments is bool)
          && (!('follows' in p) || p.follows is bool)
          && (!('followRequests' in p) || p.followRequests is bool)
          && (!('circles' in p) || p.circles is bool)
          && (!('spaces' in p) || p.spaces is bool)
        );
    }

    function notificationPreferencesUnchangedOrValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['notificationPreferences'])
        || notificationPreferencesValid();
    }

    function subscriptionFieldsUnchanged() {
      let protectedFields = [
        'subscriptionTier', 'stripeCustomerId', 'stripeSubscriptionId', 'trialExpiresAt',
        'appleOriginalTransactionId', 'appleProductId', 'subscriptionExpiresAt'
      ];
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields));
    }

    // When adding new fields to UserProfile in src/lib/auth.tsx,
    // also add them here to allow client writes. This list is pinned
    // equal to src/lib/profileFieldRegistry.ts by the D1 parity test
    // (src/lib/__tests__/profileFieldRegistry.test.ts) — drift fails CI.
    function allowedUserFields() {
      return [
        'uid', 'displayName', 'email', 'athleteType', 'weightKg', 'heightCm',
        'weeklyWorkoutsTarget', 'weeklyMealsTarget', 'preferredWeightUnit',
        'liftingWeightUnit', 'preferredDistanceUnit',
        'preferredHeightUnit', 'darkMode', 'onboardingComplete', 'trialExpiresAt',
        'subscriptionTier', 'stripeCustomerId', 'stripeSubscriptionId',
        'currentStreak', 'longestStreak', 'lastLogDate', 'program', 'tdeeBase',
        'aiCalorieAdjustment', 'targetCalories', 'targetProtein', 'targetCarbs',
        'targetFat', 'goal', 'autoRestTimer', 'defaultRestSeconds',
        'defaultVisibility', 'autoPostRuns', 'autoPostWorkouts', 'audioCues',
        'hideSharedRouteEnds',
        // Soc11 share answers, per type. Value-gated by shareDefaultsValid()
        // above; also in profileSanitizer.js.
        'shareDefaults',
        // S3 activity notification switches. Value-gated by
        // notificationPreferencesValid() above.
        'notificationPreferences',
        // Polish2 call 4: whether each follower waits to be accepted.
        // Value-gated by approveFollowersValid() above.
        'approveFollowers',
        // #984 "Hide the number" anti-anxiety toggle — written client-side via
        // updateProfile (Settings → toggleHideWeightNumber) AND set by the
        // onboarding CF (in profileSanitizer). It was in the sanitiser + the
        // UserProfile type but NOT here, so the direct Settings toggle hit
        // permission-denied ("Couldn't save your settings"). Pinned by
        // profileFieldParity.cross.test.ts.
        'hideWeightNumber',
        // NOT in this list, deliberately (removed 2026-07-25): shoes,
        // privacyZones and mealReminders are the names of SUBCOLLECTIONS
        // (`users/{uid}/shoes`, `users/{uid}/privacyZones`) and a settings
        // doc (`users/{uid}/settings/mealReminders`) — never fields on the
        // profile document, so allow-listing them here only widened what a
        // client could write to `users/{uid}`. stepGoal, phaseMode,
        // trainingPhase and stallPopupCooldowns had no reader or writer
        // anywhere. Re-add only alongside code that actually writes the
        // field to THIS document.
        // Settings → Privacy → "AI food analysis". In the UserProfile type
        // and written client-side via updateProfile, but never allow-listed
        // here — so every toggle hit permission-denied. Third instance of
        // this exact miss (see hideWeightNumber above, goalWeightKg below);
        // the type↔registry parity test now covers the pair that was unpinned.
        'aiAnalysisEnabled',
        // #962 device-timezone capture, written on boot by AuthProvider.
        // Its write is fire-and-forget behind `.catch(logger.warn)`, so the
        // rejection was invisible: `timezone` stayed null for every user, and
        // the streak-nudge CF treats null as "skip — no overnight pings".
        // Also part of the SIGNUP payload (createDefaultProfile emits
        // `timezone: null`), which `create` gates with hasOnly().
        'timezone',
        'runMode', 'weeklyRunDaysTarget', 'raceGoal', 'weekSchedule',
        'weekScheduleVersion',
        // Pgm6 run-plan tuning knobs (volume preset + difficulty). Written by
        // the configurePlan CF today, but allow-listed here so a future direct
        // updateProfile write isn't silently rejected. Also in profileSanitizer.js.
        'runVolume', 'runDifficulty', 'runTimeLimits', 'runningBaseline', 'nonRaceGoal', 'liftTimeBudgetMinutes',
        // Lift4 (10): the race-setup answer on the leg trim. Also in
        // profileSanitizer.js.
        'raceLegTrim',
        'weeklyRunsTarget', 'age', 'sex', 'activityLevel', 'macroTargets',
        'targetFiber', 'targetSugar', 'targetSodium', 'targetWaterGlasses',
        'enableRolloverCalories', 'autoPostBadges', 'customCalorieTarget',
        // Goal-weight editor (#1140) — persisted by the CLIENT (Settings →
        // Goal Weight) + allowed in profileSanitizer.js, but were never added
        // to this client-write allow-list, so every Goal-Weight save was
        // rejected ("Couldn't save your settings"). Both gates now agree.
        'goalWeightKg', 'weeklyRateKg',
        'createdAt', 'updatedAt', 'photoURL', 'lastActiveAt',
        'gender', 'ageRange', 'primaryGoal', 'experience',
        // Experience auto-detection: dismissed-suggestion marker, client-only.
        'experienceSuggestionDismissed',
        'daysPerWeek',
        'equipment', 'barbellAtHome', 'preferredSplit', 'runFrequency', 'injuries', 'crewId',
        'adjustCaloriesForTraining',
        // D16 personal "why" — free-text motivation captured at onboarding and
        // editable in Settings. Client-written via updateProfile + set by the
        // onboarding CF (in profileSanitizer.js). Pinned by the D1 parity test.
        'trainingWhy',
        // Adaptive engines — client-managed state, also in profileSanitizer.js.
        // `adaptiveCapState` (Adaptive TDEE weekly-rate smoothing) shipped +
        // was written by useAdaptiveTdee but never added here, so every
        // cap-state write was silently rejected by the update rule; fixed
        // alongside `runFitness` (Adaptive Paces fitness benchmark).
        'adaptiveCapState', 'runFitness',
        // Heart-rate zones — user-measured max HR (hrZones.ts). Also in
        // profileSanitizer.js.
        'maxHeartRate',
        'trialExpiryPromptShown',
        'appleOriginalTransactionId', 'appleProductId', 'subscriptionExpiresAt'
      ];
    }

    // Self-grant guard for user-doc CREATE. A client creating its OWN
    // user doc must not set any trial/billing/subscription timestamp to a
    // non-null value. The server's computeEffectiveTier grants Pro on a
    // future trialExpiresAt REGARDLESS of subscriptionTier, so an
    // unguarded create lets a free user self-grant server Pro (incl. paid
    // AI compute) with a single direct write. Trials/subscriptions are
    // granted server-side ONLY (Stripe/Apple webhooks, Admin SDK).
    // subscriptionTier is separately pinned to 'free' by the create rule,
    // and updates are already locked by subscriptionFieldsUnchanged().
    function billingFieldsUnsetOnCreate() {
      return (!('trialExpiresAt' in request.resource.data) || request.resource.data.trialExpiresAt == null)
        && (!('subscriptionExpiresAt' in request.resource.data) || request.resource.data.subscriptionExpiresAt == null)
        && (!('stripeCustomerId' in request.resource.data) || request.resource.data.stripeCustomerId == null)
        && (!('stripeSubscriptionId' in request.resource.data) || request.resource.data.stripeSubscriptionId == null)
        && (!('appleOriginalTransactionId' in request.resource.data) || request.resource.data.appleOriginalTransactionId == null)
        && (!('appleProductId' in request.resource.data) || request.resource.data.appleProductId == null);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !isWriteFrozen(uid)
        && request.resource.data.keys().hasOnly(allowedUserFields())
        && request.resource.data.subscriptionTier == 'free'
        && billingFieldsUnsetOnCreate()
        && raceGoalValid()
        && shareDefaultsValid()
        && notificationPreferencesValid()
        && approveFollowersValid();
      allow update: if isOwner(uid)
        && !isWriteFrozen(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUserFields())
        && subscriptionFieldsUnchanged()
        && raceGoalUnchangedOrValid()
        && shareDefaultsUnchangedOrValid()
        && notificationPreferencesUnchangedOrValid()
        && approveFollowersUnchangedOrValid();
      // Freeze delete too: the deletion executor uses the Admin SDK (which
      // bypasses rules), so a client-side self-delete during the freeze /
      // tombstone window is never the executor and should be blocked.
      allow delete: if isOwnerAndNotDeleting(uid);
    }

    // User subcollections — meals, workouts, runs, weights, water, bodyweight
    // R1A-Deletion: writes frozen while accountDeletionRequests/{uid} is active.
    // Reads remain allowed so the deletion-in-progress UI can render.
    match /users/{uid}/meals/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/savedRoutines/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/savedRoutes/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/workouts/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/runs/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    // A receipt is reserved before touching HealthKit. The delete trigger
    // marks it pending so the exporting iPhone can clean up a run removed on
    // another device. The account-deletion sweep removes this collection.
    match /users/{uid}/healthWorkoutExports/{doc} {
      allow read: if isOwner(uid);
      allow create: if isOwnerAndNotDeleting(uid)
        && exists(/databases/$(database)/documents/users/$(uid)/runs/$(doc))
        && request.resource.data.runId == doc
        && request.resource.data.state == 'attempted';
      allow update: if isOwnerAndNotDeleting(uid)
        && request.resource.data.runId == doc
        && resource.data.runId == doc
        && (
          (resource.data.state in ['attempted', 'exported']
            && request.resource.data.state == 'exported'
            && exists(/databases/$(database)/documents/users/$(uid)/runs/$(doc)))
          || (request.resource.data.state == 'pending-delete'
            && !exists(/databases/$(database)/documents/users/$(uid)/runs/$(doc)))
        );
      allow delete: if isOwnerAndNotDeleting(uid)
        && resource.data.state == 'pending-delete'
        && !exists(/databases/$(database)/documents/users/$(uid)/runs/$(doc));
    }
    match /users/{uid}/weights/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/settings/{doc} {
      allow read: if isOwner(uid);
      // Monthly push claims are server-owned. Ordinary consent settings stay
      // writable; the deletion executor already erases this whole collection.
      allow write: if isOwnerAndNotDeleting(uid)
        && !doc.matches('^challenge(Announcement|Reminder)-[0-9]{4}-[0-9]{2}$');
    }
    match /users/{uid}/foodFavourites/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/waterLog/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    // Per-day macro-target snapshot (nutrition badges read the target as it
    // stood on each day). Owner-only, same shape as waterLog.
    match /users/{uid}/dailyNutrition/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/bodyweightLogs/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/programState/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/streaks/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    /* FCM device tokens — SERVER-ONLY since the packets-17+19 migration
       (#1630, Rules lock PR-E; re-cut 2026-08-03 from stale PR #1635).
       The client registers/revokes exclusively through the
       claimPushDeviceToken / releasePushDeviceToken callables
       (pushNotifications.ts: "The client NO LONGER writes
       users/{uid}/devices directly"); senders and the deletion executor
       use the Admin SDK, which bypasses these rules. Locking the path
       closes the token-forgery surface (a client writing another token
       into its own device list) and makes the callable fences
       authoritative. The old owner-read is dropped too — no client code
       reads these docs (verified: the only getDoc in pushNotifications.ts
       is settings/push), and a readable list would leak token bindings. */
    match /users/{uid}/devices/{tokenHash} {
      allow read, write: if false;
    }
    /* Push-token claim ledger (packets 17+19) — the server-owned source
       of truth for token ownership (claim status, binding, revocation
       history, send leases). Written only by the callables + senders via
       the Admin SDK. Already default-deny by absence; the explicit block
       records the decision so a future match block can't be added
       "helpfully" without tripping over this one. A readable claim would
       leak which account owns a device token. */
    match /fcmTokenClaims/{tokenHash} {
      allow read, write: if false;
    }
    /* Performance data — written ONLY by Cloud Functions
       (computeAndWritePerformanceForUser in functions/index.js writes
       to users/{uid}/performance/{weekKey}). Path was previously named
       "performanceWeeks" in this rules file but the code (server +
       client) actually uses "performance" — meaning every client
       read of TrajectoryCard / Home performance widgets was denied
       by the catch-all and fell silently to empty state. Renamed to
       match the real collection name. */
    match /users/{uid}/performance/{doc} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ========================================
    // Latent subcollections — owner-only, write-frozen during deletion
    // ========================================
    match /users/{uid}/shoes/{shoeId} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/logs/{date} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/stats/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Public profile projection — cross-user readable
    //
    // A deliberately small projection of the user doc's safe fields.
    // Written alongside the main user doc during onboarding, profile
    // update, and streak mutation. Any authenticated user can read;
    // owner-only write with a strict field allowlist — if you need
    // to add a field, extend both this allowlist AND the mirror-write
    // call sites in the same PR.
    // ========================================
    match /users/{uid}/public/{doc} {
      /* One profile, read on its own, is refused to someone its owner
         blocked (Polish3 call 1): the profile page, a props list, a
         follow request's name. The other way round is allowed, so the
         person who blocked can still see whom they blocked to unblock
         them, and the app hides the rest. A query cannot be checked per
         document, so search (the collection group, below) is filtered in
         the app. */
      allow get: if request.auth != null
        && (request.auth.uid == uid
            || !exists(/databases/$(database)/documents/blocks/$(uid)/users/$(request.auth.uid)));
      allow list: if request.auth != null;
      allow write: if isOwnerAndNotDeleting(uid)
        /* The one document this collection holds. User search reads the
           whole collection group, so any other id under a user's own
           path was a second search entry under a name of their choosing. */
        && doc == 'profile'
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'displayNameLower',
          'photoURL',
          'photoStoragePath',
          'athleteType',
          'currentStreak',
          'longestStreak',
          'createdAt',
          'badgeSummary',
          // SOC-P2f — self-declared "Training for {race}" identity.
          // Value-gated below to null or a KNOWN space id; the client
          // renders it only for race-kind spaces with an upcoming date,
          // so a stale or interest-space value degrades to nothing.
          'trainingForSpaceId',
          // The day the public streak last counted, so a reader shows a
          // lapsed streak as 0 (publicStreakAsOf). A day key, gated below.
          'lastActiveDate'
        ])
        && (
          !('lastActiveDate' in request.resource.data)
          || (request.resource.data.lastActiveDate is string
              && request.resource.data.lastActiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        )
        /* trainingForSpaceId value gate — null (opted out) or a known
           space id. Prevents arbitrary strings riding a public,
           cross-user-readable field (the same closed-vocabulary posture
           as the spaces rules' isKnownSpaceId gates). */
        && (
          !('trainingForSpaceId' in request.resource.data)
          || request.resource.data.trainingForSpaceId == null
          || (
            request.resource.data.trainingForSpaceId is string
            && isKnownSpaceId(request.resource.data.trainingForSpaceId)
          )
        )
        /* uid identity gate.
           The 'uid' field is allowed for back-compat (some clients
           mirror the grandparent path into the doc body for easier
           single-doc reads), but the value MUST equal the path's
           {uid}. Without this check, an owner could write
           `{ uid: 'victim-uid', displayName: 'Victim' }` to their
           own public profile and impersonate that uid in any
           consumer that trusts the body's `uid` field over the
           grandparent doc id (searchUsers, follow-suggestion
           render). Field-absent and matching-value
           both allowed; mismatching value rejected. */
        && (
          !('uid' in request.resource.data)
          || request.resource.data.uid == uid
        )
        /* Name length gate. Every other copy of a person's name in these
           rules is held to the app's limit (DISPLAY_NAME_MAX, pinned by
           displayNameLimit.cross.test.ts); this one is the copy search,
           profiles and suggestions show, and had none. Null and '' are
           real states (a new email signup), so they pass. A stored name
           the write leaves as it is passes too: every write here is a
           merge (the streak mirror, a photo, the race toggle), so an
           account already holding a longer name would otherwise have
           all of them refused. Only a name being written is held. */
        && (
          !('displayName' in request.resource.data)
          || request.resource.data.displayName == null
          || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() <= 50)
          || (resource != null
              && request.resource.data.displayName
                   == resource.data.get('displayName', null))
        )
        && (
          !('displayNameLower' in request.resource.data)
          || request.resource.data.displayNameLower == null
          || (request.resource.data.displayNameLower is string
              && request.resource.data.displayNameLower.size() <= 50)
          || (resource != null
              && request.resource.data.displayNameLower
                   == resource.data.get('displayNameLower', null))
        )
        /* photoURL value gate.
           Blocks tracking-pixel injection / arbitrary external URLs.
           Allowed:
           - field absent (partial update without touching photoURL)
           - null or empty string (no photo / removal — both are real
             states; null is what createDefaultProfile writes for
             email signups before any upload, '' is what removeProfilePhoto
             writes when the user clears their custom upload)
           - an origin isAllowedPhotoUrl trusts (own Storage bucket's
             screened folders, Google account photos, Apple's CDN)
           - the value already stored, left as it is (photoUnchanged)
           The null and '' checks come BEFORE the helper so those two
           real states are accepted rather than type-checked. */
        && (
          !('photoURL' in request.resource.data)
          || request.resource.data.photoURL == null
          || request.resource.data.photoURL == ''
          || isAllowedPhotoUrl(request.resource.data.photoURL)
          || photoUnchanged('photoURL')
        )
        /* photoStoragePath gate — must point to the owner's own
           profile-photos folder. Prevents writing a value that would
           trick the cleanup path into deleting someone else's blob.
           Same null-before-matches ordering as above; null is the
           legitimate state for OAuth-only users (we don't host their
           photo) and for cleared photos. */
        && (
          !('photoStoragePath' in request.resource.data)
          || request.resource.data.photoStoragePath == null
          || request.resource.data.photoStoragePath == ''
          || request.resource.data.photoStoragePath.matches('^profile-photos/' + uid + '/.*')
        )
        /* The figures other people read on a profile (survey item 18).
           They are the owner's own device's to write, so these gates bound
           the shape, not the truth: a joined date that is the server's or
           left as it was (no backdated account), streaks that are whole
           days, and a badge summary the size of the catalogue whose count
           is its own. A stored value the write leaves as it is passes, as
           the name gate's does. */
        && (
          !('createdAt' in request.resource.data)
          || request.resource.data.createdAt == request.time
          || (resource != null
              && request.resource.data.createdAt
                   == resource.data.get('createdAt', null))
        )
        // The sanitizer's bound (profileSanitizer.js: 30 characters). Every
        // search result and profile view downloads this document, so an
        // unbounded string was a near-megabyte for every reader. A stored
        // value left as it is passes, as the badges below do.
        && (
          !('athleteType' in request.resource.data)
          || request.resource.data.athleteType == null
          || (request.resource.data.athleteType is string
              && request.resource.data.athleteType.size() <= 30)
          || (resource != null
              && request.resource.data.athleteType
                   == resource.data.get('athleteType', null))
        )
        && publicProfileDaysValid('currentStreak')
        && publicProfileDaysValid('longestStreak')
        && (
          !('badgeSummary' in request.resource.data)
          || (resource != null
              && request.resource.data.badgeSummary
                   == resource.data.get('badgeSummary', null))
          || (request.resource.data.badgeSummary is map
              && request.resource.data.badgeSummary.keys().hasOnly(['earnedMap', 'count'])
              && request.resource.data.badgeSummary.earnedMap is map
              && request.resource.data.badgeSummary.earnedMap.size() <= 100
              /* Each entry is a badge id (18 characters at most) and an
                 ISO date (24). The entry cap alone left both unbounded in
                 a document every search result downloads. Rules cannot
                 visit each value, so the ids and dates are each held to
                 100 entries of 40 characters in all. join() writes a
                 number or a boolean out as text and refuses a nested map,
                 so a value's type is the reader's to check
                 (useUserProfileData skips a date that is not a string). */
              && request.resource.data.badgeSummary.earnedMap.keys().join('').size() <= 4000
              && request.resource.data.badgeSummary.earnedMap.values().join('').size() <= 4000
              && request.resource.data.badgeSummary.count
                   == request.resource.data.badgeSummary.earnedMap.size())
        );
    }

    /* A streak on the public profile: whole days, at most a century, or the
       stored value left as it is. */
    function publicProfileDaysValid(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is int
            && request.resource.data[field] >= 0
            && request.resource.data[field] <= 36600)
        || (resource != null
            && request.resource.data[field] == resource.data.get(field, null));
    }

    // Collection-group read access: user search (`searchUsers`) runs a
    // collectionGroup('public') query with a `displayName` range filter.
    // Firestore evaluates CG queries against rules that cover the leaf
    // collection at ANY depth, so we need this recursive-wildcard rule
    // in addition to the per-user rule above. The per-user rule still
    // enforces owner-only writes; this one only grants read.
    // Queries only. This also matches a single profile read, which the
    // rule above decides.
    match /{path=**}/public/{doc} {
      allow list: if request.auth != null;
    }

    // ========================================
    // Social: Activities (public feed)
    //
    // H7: authorId must match authenticated user on create. Updates
    // are split into two permitted shapes:
    //
    //   (a) Owner edits — only visibility can change post-creation.
    //       authorId / authorName / authorPhotoURL / createdAt are
    //       immutable once the activity is posted.
    //   (b) Any authenticated user can bump kudosCount / commentCount
    //       via `increment()` from toggleKudos / addComment — but they
    //       can ONLY touch those two fields, never rewrite author
    //       metadata or the activity body.
    //
    // Pre-W1f this allowed any owner update with no field allowlist,
    // which let clients rewrite authorName / visibility / kudosCount
    // / commentCount freely.
    // ========================================
    // ========================================
    // Social: Activity feed posts
    //
    // 2026-05-26 audit findings #1 + #7 + #11 — activity contract
    // hardening. Three properties pinned by `firestore.rules.test.ts`:
    //
    //   (a) Reads are VISIBILITY-AWARE. Pre-2026-05-26 this allowed
    //       any authed user to query the entire `/activities`
    //       collection, including private + followers-only docs.
    //       Now: public is read by any authed; followers-only is
    //       read by owner + actual followers; private is owner-only.
    //
    //   (b) Creates enforce a STRICT FIELD ALLOWLIST + enums + value
    //       bounds + size caps. Pre-audit any field could be written
    //       with any value — pathological payloads (10K-point GPS
    //       arrays, negative distances, junk visibility values)
    //       were accepted.
    //
    //   (c) Update + delete contracts unchanged from W1f. Counter
    //       value validation (#2 — kudos/comment increments-only)
    //       is a separate PR; this audit explicitly defers it.
    //
    // Field allowlist mirrors the postActivity write in
    // src/lib/socialApi.ts. Adding a new field there requires adding
    // it here too — fail-closed by design (unknown field rejects the
    // whole write).
    // ========================================
    match /activities/{activityId} {
      /* One post, read on its own, is refused across a block in either
         direction (Polish3 call 1): a feed copy's post, a notification's.
         A query (Explore, a profile's posts) cannot be checked per
         document, so the app filters those. */
      allow get: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || (activityVisibleTo(resource.data)
            && !blockExistsBetween(resource.data.authorId, request.auth.uid))
      );
      allow list: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || activityVisibleTo(resource.data)
      );

      allow create: if request.auth != null
        && !isWriteFrozen(request.auth.uid)
        // Feed posts are public content — verified email only.
        && isEmailVerified()
        // A restricted account may keep a private post, not share one.
        && (request.resource.data.visibility == 'private' || !isRestricted())
        && request.resource.data.authorId == request.auth.uid
        // Field allowlist — fail-closed; adding a field to
        // postActivity requires adding it here too.
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhotoURL',
          'type', 'visibility',
          'createdAt', 'kudosCount', 'commentCount',
          'workoutName', 'runName', 'activityTitle',
          'exerciseCount', 'totalVolume', 'duration',
          'distance', 'avgPace', 'elevationGain', 'calories',
          'muscleGroups', 'exercises',
          'prHit', 'prExercise', 'prWeight', 'prCount',
          'challengeMilestone', 'badgeEarned',
          'routePreview', 'caption'
        ])
        // Required fields + types
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        // Every copied name is capped at the one display-name limit,
        // pinned equal to the app's and the server's by
        // src/lib/__tests__/displayNameLimit.cross.test.ts.
        && request.resource.data.authorName.size() <= 50
        // authorPhotoURL is loaded as <img src> by every feed viewer.
        // postActivity omits it when the author has no photo (never
        // null or ''), so present means a trusted origin or nothing.
        && (
          !('authorPhotoURL' in request.resource.data.keys())
          || isAllowedPhotoUrl(request.resource.data.authorPhotoURL)
        )
        && request.resource.data.type in ['run', 'workout']
        && request.resource.data.visibility in ['public', 'followers', 'private']
        // The server's time, as postActivity sends it (serverTimestamp).
        // Discover orders by it, so a date in 2099 pinned a post at the
        // top of everyone's Discover for good.
        && request.resource.data.createdAt == request.time
        && request.resource.data.kudosCount == 0
        && request.resource.data.commentCount == 0
        // Payload size caps — pathological payload prevention
        && (
          !('routePreview' in request.resource.data.keys())
          || request.resource.data.routePreview.size() <= 5000
        )
        && (
          !('exercises' in request.resource.data.keys())
          || request.resource.data.exercises.size() <= 100
        )
        && (
          !('muscleGroups' in request.resource.data.keys())
          || request.resource.data.muscleGroups.size() <= 20
        )
        // Numeric bounds — when present, must be in plausible range
        && (
          !('distance' in request.resource.data.keys())
          || (request.resource.data.distance >= 0
              && request.resource.data.distance <= 500000)  // 500 km — covers ultras
        )
        && (
          !('duration' in request.resource.data.keys())
          || (request.resource.data.duration >= 0
              && request.resource.data.duration <= 86400)  // 24 h
        )
        && (
          !('elevationGain' in request.resource.data.keys())
          || (request.resource.data.elevationGain >= 0
              && request.resource.data.elevationGain <= 20000)  // 20 km vertical
        )
        && (
          !('calories' in request.resource.data.keys())
          || (request.resource.data.calories >= 0
              && request.resource.data.calories <= 50000)  // ultra-endurance ceiling
        )
        && (
          !('totalVolume' in request.resource.data.keys())
          || (request.resource.data.totalVolume >= 0
              && request.resource.data.totalVolume <= 1000000)  // 1M kg per session is plenty
        )
        && (
          !('exerciseCount' in request.resource.data.keys())
          || (request.resource.data.exerciseCount >= 0
              && request.resource.data.exerciseCount <= 200)
        )
        && (
          !('prWeight' in request.resource.data.keys())
          || (request.resource.data.prWeight >= 0
              && request.resource.data.prWeight <= 1000)
        )
        && (
          !('prCount' in request.resource.data.keys())
          || (request.resource.data.prCount >= 0
              && request.resource.data.prCount <= 1000)
        )
        // A pace is seconds a kilometre (runCompletion), or on an older
        // post the text "5:34": the card prints a string as it is, so one
        // is held to a pace's length.
        && (
          !('avgPace' in request.resource.data.keys())
          || request.resource.data.avgPace is number
          || (request.resource.data.avgPace is string
              && request.resource.data.avgPace.size() <= 16)
        )
        // String length caps
        && (
          !('workoutName' in request.resource.data.keys())
          || request.resource.data.workoutName.size() <= 200
        )
        && (
          !('runName' in request.resource.data.keys())
          || request.resource.data.runName.size() <= 200
        )
        && (
          !('activityTitle' in request.resource.data.keys())
          || request.resource.data.activityTitle.size() <= 200
        )
        && (
          !('prExercise' in request.resource.data.keys())
          || request.resource.data.prExercise.size() <= 200
        )
        && (
          !('challengeMilestone' in request.resource.data.keys())
          || request.resource.data.challengeMilestone.size() <= 200
        )
        && (
          !('badgeEarned' in request.resource.data.keys())
          || request.resource.data.badgeEarned.size() <= 200
        )
        // The share sheets' optional note, cut at CAPTION_MAX
        // (src/lib/activityPost.ts). size() counts UTF-16 code units,
        // the unit the sheets cut in, so the two limits are one number.
        && (
          !('caption' in request.resource.data.keys())
          || (request.resource.data.caption is string
              && request.resource.data.caption.size() <= 140)
        );

      // 2026-05-26 audit PR 2 (finding #2) — counter writes are now
      // SERVER-ONLY. Client direct writes to kudosCount/commentCount
      // are denied; mutations route through toggleKudosCallable +
      // addCommentCallable + deleteCommentCallable in functions/index.js
      // which flip the counter and underlying kudos/comment doc in
      // one Firestore transaction.
      allow update: if request.auth != null
        && !isWriteFrozen(request.auth.uid)
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['visibility'])
        // The same three values a create may hold.
        && request.resource.data.visibility in ['public', 'followers', 'private']
        // A flagged activity stays private. The word filter
        // (onActivityCreated) and a moderator's Hide content both flag
        // it and make it private; without this its author could make
        // it public again with one write, undoing both.
        && (
          resource.data.get('flagged', false) != true
          || request.resource.data.visibility == 'private'
        )
        // A restricted account may narrow who sees a post, never widen it.
        && (
          request.resource.data.visibility == 'private'
          || (request.resource.data.visibility == 'followers'
              && resource.data.visibility == 'public')
          || !isRestricted()
        );
      allow delete: if request.auth != null
        && !isWriteFrozen(request.auth.uid)
        && resource.data.authorId == request.auth.uid;
    }

    // ========================================
    // Challenges — global, auto-seeded by seedChallenges() on the
    // client.
    //
    // PR K (audit P1 #11): pre-PR-K this allowed `write: if
    // request.auth != null` — any authed user could create junk
    // docs with arbitrary IDs OR overwrite existing entries with
    // poisoned payloads (the seedChallenges idempotent guard
    // protected against the legitimate-client path but couldn't
    // stop a malicious caller). The replacement:
    //
    //   - Reads stay open to any authed user (global metadata).
    //   - Creates require the docId to match one of the five
    //     known seed prefixes used by seedChallenges():
    //       weekly-     · weekly workout challenge
    //       monthly-    · monthly mileage / equivalent
    //       seasonal-   · seasonal challenge (rotates)
    //       fastest-5k- · pace-based monthly challenge
    //       group-goal- · collective monthly target
    //     Random-ID junk is now denied. New prefixes added to
    //     seedChallenges() must be allowlisted here too — fail-
    //     closed by design.
    //   - Updates + deletes are locked to admin SDK. The client
    //     seedChallenges path only writes when !exists, so it
    //     never needs update permissions — closing this off
    //     means a compromised client can't corrupt an existing
    //     challenge document.
    //
    // Participant docs: read by any authed user (leaderboard reads
    //   need to see other people's progress); write only by the
    //   participant themselves.
    // 2026-05-26 audit PR 4 (finding #4) — strict body validation
    // on challenge create. The ID prefix allowlist stays; on top of
    // it the create body is now:
    //   - `keys().hasOnly([...])` allowlist (no extra fields)
    //   - `type` and `metric` enums match the documented unions
    //   - `name` / `description` / `icon` length bounded
    //   - `tiers` shape locked: bronze + silver + gold required, all
    //     non-negative numbers
    //   - `participantCount` MUST start at 0 (forgery prevention)
    //   - `startDate` / `endDate` must be timestamps with endDate ≥
    //     startDate (rules can't compare dates directly, but rejecting
    //     non-timestamp values cleanly bounces malformed payloads).
    //
    // Pre-PR-4 the rule allowed create with any of 5 ID prefixes but
    // NO body validation — a hostile user could ship a challenge with
    // `name: "Tropos: pay $500 to claim your prize"` and have it show
    // up in every user's challenges UI. The seed flow in
    // `useChallenges.ts seedChallenges()` writes the canonical shape,
    // so this rule matches the legitimate seeder exactly.
    function isValidChallengeBody() {
      return request.resource.data.keys().hasOnly([
        'name', 'description', 'type', 'metric', 'icon',
        'tiers', 'startDate', 'endDate', 'participantCount',
        'createdAt', 'targetDistance', 'collectiveTarget'
      ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.type in ['weekly', 'monthly', 'seasonal']
        && request.resource.data.metric in [
          'workout_count', 'total_volume', 'total_km', 'fastest_effort'
        ]
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 50
        && request.resource.data.tiers is map
        && request.resource.data.tiers.keys().hasAll(['bronze', 'silver', 'gold'])
        && request.resource.data.tiers.bronze is number
        && request.resource.data.tiers.bronze >= 0
        && request.resource.data.tiers.silver is number
        && request.resource.data.tiers.silver >= 0
        && request.resource.data.tiers.gold is number
        && request.resource.data.tiers.gold >= 0
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.participantCount == 0
        && (
          !('targetDistance' in request.resource.data.keys())
          || (request.resource.data.targetDistance is number
              && request.resource.data.targetDistance > 0)
        )
        && (
          !('collectiveTarget' in request.resource.data.keys())
          || (request.resource.data.collectiveTarget is number
              && request.resource.data.collectiveTarget > 0)
        );
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      // Global challenge definitions are SERVER-OWNED. They are materialised by
      // the rolloverChallenges scheduled function (Admin SDK, bypasses rules);
      // the client only reads them and writes its own participant doc below.
      // Previously create was open to any authenticated client for the five
      // time-windowed prefixes subject to isValidChallengeBody() — that let any
      // browser create global product metadata, and the rule was effectively
      // doing a server's job. With seeding moved server-side, all client
      // mutation of the challenge doc itself is denied. (isValidChallengeBody()
      // below is retained but now unreferenced — harmless.)
      allow create, update, delete: if false;

      // A challenge with no endDate is a malformed definition the app still
      // lists; it is not refused here.
      function challengeTakesJoins(id) {
        let path = /databases/$(database)/documents/challenges/$(id);
        return !exists(path)
          || !('endDate' in get(path).data)
          || !(get(path).data.endDate is timestamp)
          || request.time < get(path).data.endDate + duration.value(12, 'h');
      }

      // ========================================
      // Participant docs — leaderboard entries.
      //
      // Reads stay open to any authed user (the leaderboard must show
      // other people's progress; the parent challenge doc is global).
      //
      // 2026-06-07 audit (HIGH) — currentValue + tierAchieved are now
      // SERVER-OWNED. Pre-fix the rule was `request.auth.uid == uid`
      // with NO field allowlist / bounds / immutability: a user could
      // setDoc ANY body to their own participant doc, including a forged
      // currentValue / tierAchieved. syncChallengeProgress
      // (functions/index.js, Admin SDK) does current+incrementBy on top
      // of whatever is stored, so a forged base value was permanently
      // baked into the world-readable leaderboard (sorted by
      // currentValue desc). This mirrors the server-owned-counter
      // lock-downs already applied in this file to kudosCount /
      // commentCount / memberCount / participantCount.
      //
      //   - CREATE (join): an identity/join payload only. currentValue
      //     MUST start at 0 (or be omitted); tierAchieved MUST be null
      //     (or omitted). joinedAt + the cosmetic identity fields
      //     (displayName, photoURL, uid) are allowed. The optional `uid`
      //     body field, if present, must equal the path's {uid}
      //     (impersonation guard, same idiom as the public profile).
      //   - UPDATE: only the cosmetic identity fields may change. Any
      //     diff that touches currentValue or tierAchieved is denied —
      //     those are written ONLY by the Admin SDK triggers, which
      //     bypass these rules.
      //   - DELETE (leave): the participant themselves.
      // ========================================
      match /participants/{uid} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && !isWriteFrozen(uid)
          && !isRestricted()
          // No joining a challenge that has ended. The app ends one at
          // local midnight of its UTC end day, up to twelve hours after
          // the stored endDate, so that is when joins close (the same
          // moment as challengeJoinClosed in functions/lib/challengeBackfill.js).
          && challengeTakesJoins(challengeId)
          && request.resource.data.keys().hasOnly([
            'currentValue', 'tierAchieved', 'joinedAt',
            'displayName', 'photoURL', 'uid'
          ])
          // Server-owned fields must start neutral on join.
          && (
            !('currentValue' in request.resource.data)
            || request.resource.data.currentValue == 0
          )
          && (
            !('tierAchieved' in request.resource.data)
            || request.resource.data.tierAchieved == null
          )
          // uid body field (if mirrored) must match the path.
          && (
            !('uid' in request.resource.data)
            || request.resource.data.uid == uid
          )
          // Identity field type/length caps.
          && (
            !('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50)
          )
          && (
            !('photoURL' in request.resource.data)
            || isAllowedPhotoUrl(request.resource.data.photoURL)
          );

        // Updates may ONLY touch cosmetic identity fields. Any diff
        // that affects currentValue or tierAchieved is rejected —
        // server-only via the Admin SDK triggers.
        allow update: if request.auth != null
          && request.auth.uid == uid
          && !isWriteFrozen(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoURL'])
          && (
            !('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50)
          )
          && (
            !('photoURL' in request.resource.data)
            || isAllowedPhotoUrl(request.resource.data.photoURL)
            || photoUnchanged('photoURL')
          );

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && !isWriteFrozen(uid);
      }
    }

    // ========================================
    // Community Spaces (Spc1, 2026-07-12) — the curated public layer.
    //
    // The space TAXONOMY is client config (src/features/spaces/
    // spaceDefs.ts) — there is no parent doc to create, and the id
    // allowlist below is pinned equal to SPACE_IDS by
    // src/features/spaces/__tests__/spaceDefs.test.ts (the D1-parity
    // idiom). Users join/leave and post; NOBODY creates spaces through
    // the API surface — Tropos ships new spaces as config.
    // ========================================
    function isKnownSpaceId(spaceId) {
      return spaceId in [
        'new-to-tropos', 'hybrid-training', 'womens-running',
        'runners', 'trail-running', 'lifters', 'triathlon-multisport',
        'travel-racecations',
        // Races & Events (kind "race", plan locked 2026-07-19)
        'london-marathon', 'manchester-marathon', 'brighton-marathon',
        'edinburgh-marathon', 'great-north-run', 'the-big-half',
        'royal-parks-half', 'cardiff-half', 'london-10000',
        'great-birmingham-run', 'great-manchester-run', 'leeds-10k',
        // Marathon expansion (2026-09-14)
        'yorkshire-marathon',
        'chester-marathon',
        'loch-ness-marathon',
        'newport-marathon',
        'belfast-marathon',
        'leeds-marathon',
        'milton-keynes-marathon',
        'southampton-marathon',
        'new-york-city-marathon',
        'chicago-marathon',
        'boston-marathon',
        'paris-marathon',
        'berlin-marathon',
        'dublin-marathon',
        // Winter and spring additions
        'valencia-marathon', 'houston-marathon', 'seville-marathon',
        'brighton-half', 'tokyo-marathon', 'cambridge-half',
        'bath-half', 'barcelona-marathon',
        'sydney-marathon',
        'amsterdam-marathon',
        'rotterdam-marathon',
        'copenhagen-marathon',
        'oxford-half',
        'great-bristol-10k',
        'edinburgh-5k',
        'river-ness-5k',
        'edinburgh-half',
        'bournemouth-half',
        'sheffield-half',
        'valencia-half',
        'edinburgh-10k',
        'bournemouth-10k',
        'lincoln-10k',
        'york-10k',
        'river-ness-10k',
        'bournemouth-5k',
        'supernova-forth-5k',
        'supernova-kelpies-5k',
        'race-to-the-king-100k',
        'race-to-the-stones-100k',
        'chiltern-50',
        'cape-town-marathon',
        'rome-marathon',
        'athens-marathon',
        'prague-marathon',
        'vienna-marathon',
        'frankfurt-marathon',
        'honolulu-marathon',
        'los-angeles-marathon'
      ];
    }

    // Tropos Team badge / pin / moderation authority — uids listed in
    // system/config.officialUids (same doc as the deletion
    // kill-switch). Missing doc or field makes the get() error, which
    // evaluates FALSE: nobody is official until the operator sets the
    // list. Callers must short-circuit this behind the ordinary-user
    // branch (|| isOfficialUid()) so normal writes never evaluate it.
    function isOfficialUid() {
      return request.auth.uid in
        get(/databases/$(database)/documents/system/config)
          .data.officialUids;
    }

    match /spaces/{spaceId} {
      // No parent doc in v1 (member counts are client aggregate
      // queries over /members — no forgeable counter, no trigger).
      // Deny all direct access so nothing squats metadata at this
      // path before a future server owns it.
      allow read, write: if false;

      // Membership — one doc per member, self-owned. Mirrors the
      // hardened challenge-participant contract: identity-only body,
      // path-uid binding, cosmetic-only updates.
      match /members/{uid} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && isKnownSpaceId(spaceId)
          && !isWriteFrozen(uid)
          && !isRestricted()
          && request.resource.data.keys().hasOnly([
            'joinedAt', 'displayName', 'photoURL', 'uid'
          ])
          && (
            !('uid' in request.resource.data)
            || request.resource.data.uid == uid
          )
          && (
            !('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50)
          )
          && (
            !('photoURL' in request.resource.data)
            || isAllowedPhotoUrl(request.resource.data.photoURL)
          );

        allow update: if request.auth != null
          && request.auth.uid == uid
          && !isWriteFrozen(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoURL'])
          && (
            !('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50)
          )
          && (
            !('photoURL' in request.resource.data)
            || isAllowedPhotoUrl(request.resource.data.photoURL)
            || photoUnchanged('photoURL')
          );

        allow delete: if request.auth != null
          && request.auth.uid == uid
          && !isWriteFrozen(uid);
      }

      // Posts — title + body + optional attached-activity snapshot +
      // (PR4) photoUrl. likeCount / commentCount are SERVER-OWNED
      // (kudos-lockdown idiom): they must start neutral and no client
      // diff may touch them. official / pinned are unforgeable — an
      // ordinary author may omit them or write false; only uids on
      // system/config.officialUids may set them true (the Tropos Team
      // badge, Spc1c).
      match /posts/{postId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && isKnownSpaceId(spaceId)
          && !isWriteFrozen(request.auth.uid)
          // Space posts are public content — verified email only.
          && isEmailVerified()
          && !isRestricted()
          && request.resource.data.authorId == request.auth.uid
          // Posting requires membership (Spc1 engineering pin).
          && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'authorPhotoURL', 'title', 'body',
            'activity', 'photoUrl', 'official', 'pinned',
            'likeCount', 'commentCount', 'createdAt'
          ])
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 4000
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() >= 1
          && request.resource.data.authorName.size() <= 50
          && (
            !('title' in request.resource.data)
            || (request.resource.data.title is string
                && request.resource.data.title.size() <= 120)
          )
          && (
            !('authorPhotoURL' in request.resource.data)
            || isAllowedPhotoUrl(request.resource.data.authorPhotoURL)
          )
          && (
            !('photoUrl' in request.resource.data)
            || isOwnSpacePhotoUrl(request.resource.data.photoUrl)
          )
          // The attached session is the composer's snapshot
          // (src/features/spaces/spacePostSnapshot.ts, whose key list
          // spacePostSnapshot.cross.test.ts pins to this one), served to
          // every viewer of the Space. `is map` alone took 500 KB of
          // anything.
          && (
            !('activity' in request.resource.data)
            || (request.resource.data.activity is map
                && request.resource.data.activity.keys().hasOnly([
                     'type', 'distance', 'avgPace', 'duration',
                     'elevationGain', 'routePreview', 'totalVolume',
                     'exerciseCount', 'muscleGroups', 'leadExerciseId'
                   ])
                && request.resource.data.activity.get('type', null)
                     in ['run', 'workout']
                // The composer downsamples a route to 40 points.
                && (
                  !('routePreview' in request.resource.data.activity)
                  || (request.resource.data.activity.routePreview is list
                      && request.resource.data.activity.routePreview.size() <= 100)
                )
                && (
                  !('muscleGroups' in request.resource.data.activity)
                  || (request.resource.data.activity.muscleGroups is list
                      && request.resource.data.activity.muscleGroups.size() <= 20)
                )
                && (
                  !('leadExerciseId' in request.resource.data.activity)
                  || (request.resource.data.activity.leadExerciseId is string
                      && request.resource.data.activity.leadExerciseId.size() <= 200)
                ))
          )
          // The server's time, as the composer sends it: the Space's
          // posts are listed newest first by it.
          && request.resource.data.createdAt == request.time
          && (
            !('likeCount' in request.resource.data)
            || request.resource.data.likeCount == 0
          )
          && (
            !('commentCount' in request.resource.data)
            || request.resource.data.commentCount == 0
          )
          && (
            (
              (
                !('official' in request.resource.data)
                || request.resource.data.official == false
              )
              && (
                !('pinned' in request.resource.data)
                || request.resource.data.pinned == false
              )
            )
            || isOfficialUid()
          );

        // Authors edit their own words (title/body only — counters,
        // badge, pin, and identity stay immutable to them). Officials
        // may (un)pin any post — the curation lever. The actor-freeze
        // sits before both branches: a frozen/tombstoned actor cannot
        // edit or moderate (an official moderating a frozen author's
        // post is unaffected — the freeze is on the actor, not author).
        allow update: if request.auth != null
          && !isWriteFrozen(request.auth.uid)
          && (
            (
              resource.data.authorId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['title', 'body'])
              && !isRestricted()
              && request.resource.data.body is string
              && request.resource.data.body.size() >= 1
              && request.resource.data.body.size() <= 4000
              && (
                !('title' in request.resource.data)
                || (request.resource.data.title is string
                    && request.resource.data.title.size() <= 120)
              )
            )
            || (
              isOfficialUid()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['pinned'])
              && request.resource.data.pinned is bool
            )
          );

        // Authors delete their own posts; officials moderate-delete
        // anything (the S4 report → takedown path).
        allow delete: if request.auth != null
          && !isWriteFrozen(request.auth.uid)
          && (
            resource.data.authorId == request.auth.uid
            || isOfficialUid()
          );

        // SOC-P2c — post likes. Doc id IS the liker uid. Reads are
        // open to signed-in users (the client needs "did I like this"
        // + the post itself is auth-readable); ALL writes are
        // server-only via toggleSpacePostLikeCallable, which flips
        // this doc and the post's server-owned likeCount in one
        // transaction (the activity-kudos lockdown, applied here).
        match /likes/{likeUid} {
          allow read: if request.auth != null;
        }

        // SOC-P2g — post comments. Same lockdown: signed-in READ (the
        // comment sheet lists them), ALL writes server-only via the
        // addSpacePostComment/deleteSpacePostComment callables, which
        // flip the doc and the post's server-owned commentCount in one
        // transaction. Author-only deletes + the report takedown path
        // are enforced in the callables.
        match /comments/{commentId} {
          allow read: if request.auth != null;
        }
      }
    }

    // ========================================
    // Social: Feeds — user can read their own feed; writes are
    // server-only via the onActivityCreated trigger.
    //
    // 2026-05-26 audit PR 3 (finding #3) — pre-PR-3 the client did
    // fan-out from postActivity, writing one feed item per follower
    // directly. The `authorId == auth.uid` check stopped
    // impersonation but couldn't gate volume — a script could push
    // 100k items into any follower's feed. Now create is server-only
    // (via socialFanout.fanoutActivityToFeeds, invoked from the
    // onActivityCreated trigger). Author-side R1A is enforced in the
    // trigger via shouldSystemWriteProceed + compensating delete;
    // recipient-side cleanup is via the deletion executor's Phase D
    // sweep of feeds/{uid}/items.
    //
    // Delete stays client-writable so users can clear their own feed.
    // Owner freeze applied on delete to keep the deletion-actor
    // invariant ("a deleting user does not write anywhere") consistent.
    // ========================================
    match /feeds/{uid}/items/{doc} {
      // Legacy rows carry names and session summaries even after access to
      // their parent is revoked. Refuse those immediately during migration.
      // V2 is server-only and contains routing ids + ordering/expiry only;
      // every displayed detail is fetched under the parent activity's rules.
      // Listeners/queries constrain schemaVersion == 2 (rules aren't filters).
      allow read: if isOwner(uid) && resource.data.schemaVersion == 2;
      allow create: if false;
      allow delete: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Social: Kudos
    // H7: userId (doc ID) must match authenticated user
    // ========================================
    // Packet 13 — a kudos/comment child must obey its PARENT activity's
    // visibility. Pre-packet-13 child reads were open to any authed user, so
    // anyone holding an activity id could read the kudos/comment lists of a
    // private or followers-only activity. This mirrors the parent
    // activities/{id} read relation exactly (public / owner / accepted
    // follower). References only the parent activity + one follower doc.
    function canReadActivityChild(activityId) {
      let activityPath =
        /databases/$(database)/documents/activities/$(activityId);

      return request.auth != null
        && exists(activityPath)
        && (
          get(activityPath).data.visibility == 'public'
          || get(activityPath).data.authorId == request.auth.uid
          || (
            get(activityPath).data.visibility == 'followers'
            && exists(
              /databases/$(database)/documents/followers/$(get(activityPath).data.authorId)/users/$(request.auth.uid)
            )
            // The parent's block check: a follow edge can outlive a block.
            && !blockExistsBetween(get(activityPath).data.authorId, request.auth.uid)
          )
        );
    }

    // 2026-05-26 audit PR 2 (finding #2) — kudos doc writes are
    // server-only via toggleKudosCallable, which flips the kudos
    // sub-doc + the activity's kudosCount atomically. Reads now obey the
    // parent activity's visibility (packet 13).
    match /kudos/{activityId}/users/{userId} {
      allow read: if canReadActivityChild(activityId);
      allow create, delete: if false;
    }

    // ========================================
    // Social: Comments
    //
    // H7: authorId must match authenticated user on create. Pre-W1f
    // the delete rule was missing entirely, which meant the client-
    // side deleteComment (guarded by a JS check against author) was
    // always hitting permission-denied and silently failing — users
    // couldn't actually delete their own comments. Added explicit
    // delete rule that enforces the same "author only" policy
    // server-side.
    // ========================================
    // 2026-05-26 audit PR 2 (finding #2) — comment writes are
    // server-only via addCommentCallable / deleteCommentCallable
    // which manage the commentCount atomically with the comment doc.
    // Reads stay open.
    match /comments/{activityId}/items/{commentId} {
      allow read: if canReadActivityChild(activityId);
      allow create, delete: if false;
    }

    // ========================================
    // Social: Following / Followers
    // H7: only the owner of the follow relationship can manage it
    // ========================================
    match /following/{uid}/users/{targetUid} {
      allow read: if request.auth != null;
      // R1A-Deletion: freeze writes when either side is deleting.
      // Owner (uid) is the user managing their own follow list;
      // targetUid is the user being followed/unfollowed — both must
      // be writable.
      // Delete stays unconditional — unfollowing must ALWAYS work, including
      // unwinding an edge that predates a block.
      allow delete: if (
          isOwnerAndNotDeleting(uid)
          && !isWriteFrozen(targetUid)
        )
        // The person followed may remove the follow of someone they have
        // blocked: blocking severs both directions.
        || (
          request.auth != null
          && request.auth.uid == targetUid
          && exists(/databases/$(database)/documents/blocks/$(targetUid)/users/$(uid))
          && !isWriteFrozen(targetUid)
        );
      // A follow is direct only to an account that does not approve
      // followers; otherwise the person followed writes it on accepting.
      allow create: if (
          isOwnerAndNotDeleting(uid)
          && !isWriteFrozen(targetUid)
          && !blockExistsBetween(uid, targetUid)
          && !isRestricted()
          && !approvesFollowers(targetUid)
          && isDirectFollowEdge()
        )
        || (acceptsFollowRequest(targetUid, uid) && isAcceptedFollowEdge());
    }

    match /followers/{uid}/users/{followerUid} {
      allow read: if request.auth != null;
      // Follower doc is written by the person doing the following.
      // R1A-Deletion: writer (followerUid) and recipient (uid) both
      // must be writable. A direct follow never carries `fromRequest`:
      // onFollowerCreated reads it as "the person asked said yes" and
      // tells the follower so, which only the person asked may say.
      allow delete: if (
          request.auth != null
          && request.auth.uid == followerUid
          && !isWriteFrozen(followerUid)
          && !isWriteFrozen(uid)
        )
        // The person followed may remove a follower they have blocked:
        // this is the edge that lets the follower read followers-only
        // posts.
        || (
          request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/blocks/$(uid)/users/$(followerUid))
          && !isWriteFrozen(uid)
        );
      // Documents this reads: each isWriteFrozen reads a deletion request
      // and a tombstone, blockExistsBetween two block records, isRestricted
      // and approvesFollowers one each. Eight, against Firestore's limit of
      // ten access calls for a single-document request; count before adding
      // another get() or exists() here.
      allow create: if (
          request.auth != null
          && request.auth.uid == followerUid
          && !isWriteFrozen(followerUid)
          && !isWriteFrozen(uid)
          && !blockExistsBetween(uid, followerUid)
          && !isRestricted()
          && !approvesFollowers(uid)
          // A direct follow never carries `fromRequest`: only the person
          // asked may say they said yes.
          && isDirectFollowEdge()
        )
        || (acceptsFollowRequest(uid, followerUid) && isAcceptedFollowEdge());
    }

    /* A follow waiting to be accepted (Polish2 call 4): who asked
       (requesterUid) and who was asked (uid). Its own collection, so every
       reader of followers/ and following/ (feeds, followers-only posts,
       props and comments, partner bonds, counts) still reads only follows
       that were accepted. Seen only by the two people. */
    match /followRequests/{uid}/users/{requesterUid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == requesterUid);
      allow create: if request.auth != null
        && request.auth.uid == requesterUid
        && requesterUid != uid
        && !isWriteFrozen(requesterUid)
        && !isWriteFrozen(uid)
        && !blockExistsBetween(uid, requesterUid)
        && !isRestricted()
        && request.resource.data.keys().hasOnly(['requestedAt'])
        && request.resource.data.requestedAt == request.time;
      // Cancelled by who asked; accepted or declined by who was asked.
      // Either may always remove it, like unfollowing.
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == requesterUid);
    }

    /* A person's week on friends' boards (Polish2 call 5): sessions,
       distance and volume, kept by the server (functions/lib/
       friendsBoard.js) only for someone who said yes. Read by them and by
       their followers, who are people they accepted, never across a block
       either way, as followers-only posts are read. */
    match /friendsBoard/{uid} {
      allow read: if request.auth != null
        && (
          request.auth.uid == uid
          || (
            exists(/databases/$(database)/documents/followers/$(uid)/users/$(request.auth.uid))
            && !blockExistsBetween(uid, request.auth.uid)
          )
        );
      allow write: if false;
    }

    // ========================================
    // Partner streaks (SOCIAL S3): a 1:1 bond between two users that
    // tracks a shared streak (days both logged a session). Only the two
    // members may read or write their bond.
    //
    //   - READ: either member.
    //   - CREATE: SERVER-ONLY (`if false`). Each person holds at most five
    //     bonds, and rules cannot count documents, so the
    //     startPartnerStreak callable makes every bond in a transaction
    //     that counts both people's (functions/lib/partnerBonds.js). It
    //     holds what this rule held: two distinct members at the pair's
    //     sorted id, a mutual follow, no block either way, neither account
    //     mid-deletion, the starter not restricted, and the cold initial
    //     state the engine reads.
    //   - UPDATE: SERVER-ONLY (`if false`). Streak state is materialized by
    //     the Cloud Function persist path (applyPartnerActivity on
    //     onWorkoutCreated / onRunCreated, via the Admin SDK which bypasses
    //     rules) — the engine runs server-side (Soc7). Pre-Soc7 this allowed
    //     either member to write streak fields; once the engine moved
    //     server-side that client path became BOTH unused AND a cheat vector
    //     (a member could hand-edit their own shared streak). `if false`
    //     removes it and the client/server double-writer race.
    //   - DELETE: either member may dissolve the bond. It is the one
    //     client write left.
    //
    // R1A-Deletion: bonds the deleted user is a member of are tombstoned
    // by the account-deletion executor (added to accountDeletionInventory).
    // ========================================
    match /partnerBonds/{bondId} {
      function bondMember() {
        return request.auth != null
          && request.auth.uid in resource.data.members;
      }
      allow read: if bondMember();
      // Server-only: a create here could not count the bonds either person
      // already holds (see the header). The startPartnerStreak callable is
      // the one writer.
      allow create: if false;
      // Soc7: streak state is server-written (Admin SDK). No client update.
      allow update: if false;
      // A frozen/tombstoned member cannot dissolve the bond client-side;
      // the account-deletion executor sweeps their bonds (Admin SDK).
      allow delete: if bondMember()
        && !isWriteFrozen(request.auth.uid);
    }

    // ========================================
    // Social: Notifications — owner-only read; writes are server-only.
    //
    // 2026-05-26 audit PR 3 (finding #6) — pre-PR-3 the client wrote
    // notification docs directly. The `fromUserId == auth.uid` check
    // stopped impersonation but couldn't gate content (a script could
    // push fake-looking "Tropos: you owe us $500" notifications) or
    // volume (notification spam). Now create is server-only, folded
    // into toggleKudosCallable + addCommentCallable via
    // socialFanout.createNotification — that helper validates the
    // type union, length-caps strings, and forces fromUserId to the
    // authenticated caller (no client override).
    //
    // Delete stays client-writable so users can clear their inbox.
    // Owner freeze on delete keeps the "deleting users do not write
    // anywhere" invariant consistent.
    // ========================================
    match /notifications/{uid}/items/{doc} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow delete: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Social: Blocks — owner manages their own block list
    // ========================================
    match /blocks/{uid}/users/{targetUid} {
      allow read: if isOwner(uid);
      // Freeze new reverse edges for either deleting account, so cleanup
      // cannot be followed by an old client recreating the reference.
      // The owner can still remove an existing block while the target deletes.
      allow create, update: if isOwnerAndNotDeleting(uid) && !isWriteFrozen(targetUid);
      allow delete: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Social: Blocked by — who has blocked this account (Polish3 call 1)
    //
    // The copy of blocks/{blocker}/users/{uid} that the person blocked
    // can read, so their app leaves the blocker out of what it shows
    // them. Only onBlockWritten writes it (functions/lib/blockMirror.js).
    // No rule consults it, so a forged row would only hide someone from
    // the forger; it is server-only all the same, because a copy with two
    // writers drifts from what it copies.
    // ========================================
    match /blockedBy/{uid}/users/{blockerUid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ========================================
    // Reports — server-only (packet 14 lockdown)
    // ========================================
    // Reports are written ONLY by the createReport callable (Admin SDK), which
    // server-resolves the target + issues the reportAuthority marker. Direct
    // client writes are fully denied so a client-supplied report target field
    // can never become moderation input. (Defense-in-depth: the security
    // cutover already landed via the authority marker in PR2 — a forged
    // direct report was already dismiss-only. This closes the create path too.)
    // Deploy AFTER the callable client is live; a stale bundle doing a direct
    // write fails here (the client already routes through the callable).
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Packet 14 — server-issued authority marker. Only createReport (Admin
    // SDK) may write it; a client can never forge one, which is what makes a
    // report's resolved target unforgeable.
    match /reportAuthority/{reportId} {
      allow read, write: if false;
    }

    // ========================================
    // Crews (RETIRED 2026-07-20 — docs/proposals/crews-retirement.md)
    //
    // The /groups/... collection (crews) has no client surface any
    // more; the collection is explicitly locked to zero client access
    // so inert legacy seed docs stay harmlessly unreadable. The
    // account-deletion executor still sweeps legacy membership docs
    // via the Admin SDK, which bypasses rules — this block does not
    // affect it.
    // ========================================
    match /groups/{crewId} {
      allow read, write: if false;
    }

    match /groups/{crewId}/members/{userId} {
      allow read, write: if false;
    }

    // ========================================
    // User subcollection: Progress photos — owner-only
    // ========================================
    match /users/{uid}/progressPhotos/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // User subcollection: Progress Vault check-ins (BODY-VAULT-01) —
    // owner-only date/note/photo-reference groupings over the owner-only
    // progressPhotos above. Never readable by another account; no social
    // surface reads a check-in, and any future milestone share is a
    // separate summary-only event, never this doc.
    match /users/{uid}/progressCheckins/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // User subcollection: GPS privacy zones — owner-only, write-frozen during deletion.
    match /users/{uid}/privacyZones/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // User subcollection: weekly Momentum Check-ins (CHECKIN-01) — owner-only
    // private reflections keyed by review week. Never readable by another
    // account; any future Goal Space share is a separate summary-only event,
    // never this doc.
    match /users/{uid}/checkins/{weekKey} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // User subcollection: Training Blocks (PROGRAM-BLOCK-01) — owner-only
    // private block layer over the programme. Never readable by another
    // account; any future Goal Space share is a separate summary-only
    // event, never this doc.
    match /users/{uid}/trainingBlocks/{blockId} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // User subcollection: Journeys (GOALS-CORE-01) — owner-only private
    // goal intent. Kept separate from the shared goalSpaces object so a
    // solo journey can gain a Circle later without migration.
    match /users/{uid}/journeys/{journeyId} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // User subcollection: weekly nutrition-consistency commitments
    // (NUTR-CONSISTENCY-01) — owner-only. The commitment + derived
    // progress stay private; a Circle only ever receives the opt-in
    // constant status line via the goalSpaces events allowlist.
    match /users/{uid}/nutritionCommitments/{weekKey} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Goal Spaces (GOALS-CORE-01, GsPb1 lock) — invite-only Circles.
    // Space + membership docs are SERVER-OWNED (callables via Admin
    // SDK): a client can never forge membership, counts, or another
    // member's status. Reads are member-only. Events are the ONE
    // client-writable surface: strict six-kind allowlist, allowlisted
    // fields only, bounded text, author-bound — the audit's privacy
    // contract (no calories/weight/photos/GPS) is enforced by the
    // field allowlist: none of those fields can be written at all.
    // ========================================
    function isGoalSpaceMember(spaceId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/goalSpaces/$(spaceId)/members/$(request.auth.uid));
    }

    match /goalSpaces/{spaceId} {
      allow read: if isGoalSpaceMember(spaceId);
      allow write: if false;
    }

    // Short invite-code → spaceId lookup. A server-only bearer index
    // (written/read exclusively by the createGoalSpace / joinGoalSpace
    // callables via the Admin SDK). Never client-accessible: a client
    // read would let anyone enumerate codes → spaces. Default-deny would
    // already cover this; the explicit block documents the intent.
    match /goalSpaceInvites/{code} {
      allow read, write: if false;
    }

    match /goalSpaces/{spaceId}/members/{memberUid} {
      allow read: if isGoalSpaceMember(spaceId);
      allow write: if false;
    }

    match /goalSpaces/{spaceId}/events/{eventId} {
      allow read: if isGoalSpaceMember(spaceId);
      // SOCIAL-FOCUS-01: 'weekly_check_in' is server-only — the
      // goalSpaceWeeklyCheckIn callable owns the deterministic
      // ${uid}_${weekKey} event, so removing it from the
      // client-creatable kinds makes the callable the sole check-in
      // writer (the deterministic one-per-week ID and the closed
      // weeklyFocus enum can't be bypassed by an auto-ID client
      // write). Safe to tighten now: the callable is verified live in
      // the deployed functions bundle (2026-07-18, #1636 resolved).
      // weeklyFocus/supporterIds are server-written fields and stay
      // OUT of the client field allowlist below either way.
      allow create: if isGoalSpaceMember(spaceId)
        && !isWriteFrozen(request.auth.uid)
        && !isRestricted()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['joined', 'session_completed', 'milestone', 'needs_support', 'routine_shared']
        && request.resource.data.keys().hasOnly(['id', 'uid', 'kind', 'text', 'weekKey', 'createdAt'])
        // text is optional: absent or null for an event with nothing to say,
        // otherwise a string within the fence's bound.
        && (!('text' in request.resource.data)
            || request.resource.data.text == null
            || (request.resource.data.text is string
                && request.resource.data.text.size() <= 200))
        // weekKey is the writer's LOCAL week as YYYY-MM-DD. The client
        // sends null on every event it creates, so null must stay legal.
        && (!('weekKey' in request.resource.data)
            || request.resource.data.weekKey == null
            || (request.resource.data.weekKey is string
                && request.resource.data.weekKey.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        // id mirrors a document id; bounded so the field cannot carry a
        // payload into a member-readable feed.
        && (!('id' in request.resource.data)
            || (request.resource.data.id is string
                && request.resource.data.id.size() <= 64))
        // createdAt is the writer's clock in ms, which the timeline orders
        // by (survey item 20): a number, and never ahead of the server's
        // by more than a clock's drift, so an event cannot pin itself
        // above the rest. An event queued offline and sent later is older
        // than the server's time, which is true of it.
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt <= request.time.toMillis() + 300000;
      allow update, delete: if false;
    }

    // ========================================
    // Scan usage — food-scan quota tracker.
    // Written exclusively by Cloud Functions (analyzeFood /
    // analyzeFoodText use Admin SDK to bump the count); the client
    // reads it via useScanUsage to render the quota indicator.
    // Without this rule the read was denied by the catch-all and
    // the quota indicator silently fell back to "0 used".
    // ========================================
    match /scanUsage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ========================================
    // User subcollection: Client error reports
    //
    // errorReporting.persistToFirestore writes critical errors (network,
    // component, payment/auth/subscription keyword matches) here. Without
    // this rule, writes silently fail against the default-deny and the
    // error log never materialises.
    //
    // READ was `false`, "reserved for Admin-SDK support tooling" — but
    // `src/pages/Diagnostics.tsx` queries this exact collection to show the
    // user their own recent crashes, so it always rendered "none logged"
    // while the crashes sat in Firestore. Two parts of the app contradicting
    // each other, and the half that lost was the one built to make a crash
    // diagnosable. Found 2026-08-04 chasing a "Something went wrong" on the
    // Train route: the evidence existed and the app could not read it.
    //
    // Owner-read is not a weakening. These are the user's OWN crash reports;
    // the create-only stance exists so a compromised session cannot rewrite
    // its history, and update/delete stay denied for exactly that reason.
    // ========================================
    match /users/{uid}/errors/{doc} {
      allow create: if isOwnerAndNotDeleting(uid);
      allow read: if isOwner(uid);
      allow update, delete: if false;
    }

    // ========================================
    // Server-managed feature flags
    //
    // Holds kill switches the app and Cloud Functions read at runtime —
    // e.g. `geminiEnabled` to instantly cut AI food/text analysis off
    // if costs spike or Gemini is down. World-readable (any
    // authenticated client needs to see the flag before a scan) and
    // write-only from Admin-SDK / Firebase Console.
    // ========================================
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ========================================
    // ========================================
    // Audit: successful Stripe Checkout session creations
    //
    // Written exclusively by the createCheckoutSession Cloud Function
    // (Admin SDK) — never by clients. The default-deny rule at the
    // top of this file already covers it; this explicit block is here
    // to document the intent so a future "let me make this readable
    // for the dashboard" instinct hits a clear no first. Admin SDK
    // bypasses these rules so the function's writes work regardless.
    //
    // Schema lives in functions/auditLog.js — see
    // CHECKOUT_AUDIT_COLLECTION / buildCheckoutAuditEntry.
    // ========================================
    match /audit_checkout_sessions/{doc} {
      allow read, write: if false;
    }

    // ========================================
    // R1A-Deletion operational collections
    //
    // Server-written via Admin SDK only. Clients can read their own
    // ledger doc so the AccountSection UI can render the in-progress
    // / failed / pending state durably (the Chunk 4 reauth UX depends
    // on this read path). All other collections are server-only.
    // ========================================
    match /accountDeletionRequests/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Execution checkpoints, pending provider cancellation, and bounded
    // moderation evidence are never exposed through the user-readable ledger.
    match /accountDeletionWork/{uid} { allow read, write: if false; }
    match /accountDeletionBilling/{uid} { allow read, write: if false; }
    match /deletedCommentEvidence/{id} { allow read, write: if false; }

    match /deletedAccounts/{uid} {
      // Tombstone is for system-writer guards (Admin SDK reads only).
      // Clients have no legitimate need to read or write this.
      allow read, write: if false;
    }

    match /deletedBillingIdentities/{identifierHash} {
      // Hashed billing-identifier tombstone for webhook guards.
      // Server-only.
      allow read, write: if false;
    }

    match /restrictedIdentities/{identityHash} {
      // A deleted restricted account's hashed sign-in identities (S4e,
      // STATUS 2026-10-20), read by onAuthUserCreated. Server-only.
      allow read, write: if false;
    }

    match /paymentEventsPostDeletion/{eventId} {
      // Webhook log for payment events targeting tombstoned accounts.
      // Operator review only; Admin SDK reads.
      allow read, write: if false;
    }

    match /trialLedger/{uid} {
      // Legacy trial-eligibility tombstones from when completeOnboarding
      // granted a free 7-day trial on account creation. Nothing writes here
      // now (the only trial is the card trial at checkout — Sub1a pin 3);
      // the markers that exist are retained past account deletion. No PII
      // (uid + timestamps only). Clients have no legitimate read/write.
      allow read, write: if false;
    }

    // ========================================
    // Restricted-user marker (S4e lock — PR #722).
    //
    // Single doc per restricted UID. The doc's mere existence
    // signals "this user is currently restricted": every write that
    // reaches another person is refused (isRestricted() above, and
    // functions/lib/restriction.js for the callables). Schema per S4e
    // critical implication (1): { uid, restrictedAt,
    // restrictionEndsAt: null, lastActionedReport, strikes: null }.
    // strikes/restrictionEndsAt null on manual restriction; future
    // S4d-full auto-strike CF populates them.
    //
    // Reads: own-doc only — the user can read their own restriction
    // state for the UI gate. No cross-user discovery: rules-deny on
    // any uid != request.auth.uid.
    //
    // Writes: Admin SDK only. resolveReport's restrictUser creates
    // it; liftRestriction (the moderation page's Lift) deletes it.
    // Direct client writes denied.
    // ========================================
    match /globalRestrictedUids/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
