rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // Default: deny all reads and writes
    // Last deployed: 2026-03-19 — touch to trigger CI deploy
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================
    // User profiles — owner-only access
    // H1: subscriptionTier, stripeCustomerId, stripeSubscriptionId
    //     are protected from client-side writes
    // ========================================
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ========================================
    // R1A-Deletion write-freeze
    //
    // While accountDeletionRequests/{uid}.status is in the active set
    // (running / failed_cleanup / pending_cleanup / pending_auth_deletion /
    // operator_review), the user cannot create or update normal app data.
    // Reads remain allowed so the client can render UI during deletion.
    //
    // Status values exempt from the freeze (writes still allowed):
    //   - 'requested': lock not yet acquired by the executor
    //   - 'completed': cascade finished
    //   - 'cancelled': user backed out (the cancel callable bypasses
    //                  this freeze for the single status-write that
    //                  transitions out of the active set)
    //
    // Cost: each isDeleting() call performs one exists() + one get()
    // against accountDeletionRequests/{uid} — 2 of the 10-read
    // per-evaluation budget. Acceptable; the rule is applied at the
    // single write-rule level per match block.
    //
    // The Admin SDK bypasses these rules entirely, so the deletion
    // executor (deleteMyAccount + cancelDeletionRequest) still operates
    // normally during the freeze.
    // ========================================
    function isDeleting(uid) {
      let path = /databases/$(database)/documents/accountDeletionRequests/$(uid);
      return exists(path)
        && get(path).data.status in [
          'running',
          'failed_cleanup',
          'pending_cleanup',
          'pending_auth_deletion',
          'operator_review'
        ];
    }

    // Convenience for owner-write paths: caller is the owner AND has
    // no active deletion. Used by user-owned subcollection match blocks.
    function isOwnerAndNotDeleting(uid) {
      return isOwner(uid) && !isDeleting(uid);
    }

    function subscriptionFieldsUnchanged() {
      let protectedFields = [
        'subscriptionTier', 'stripeCustomerId', 'stripeSubscriptionId', 'trialExpiresAt',
        'appleOriginalTransactionId', 'appleProductId', 'subscriptionExpiresAt'
      ];
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields));
    }

    // When adding new fields to UserProfile in src/lib/auth.tsx,
    // also add them here to allow client writes.
    function allowedUserFields() {
      return [
        'uid', 'displayName', 'email', 'athleteType', 'weightKg', 'heightCm',
        'weeklyWorkoutsTarget', 'weeklyMealsTarget', 'preferredWeightUnit',
        'preferredHeightUnit', 'darkMode', 'onboardingComplete', 'trialExpiresAt',
        'subscriptionTier', 'stripeCustomerId', 'stripeSubscriptionId',
        'currentStreak', 'longestStreak', 'lastLogDate', 'program', 'tdeeBase',
        'aiCalorieAdjustment', 'targetCalories', 'targetProtein', 'targetCarbs',
        'targetFat', 'goal', 'autoRestTimer', 'defaultRestSeconds',
        'defaultVisibility', 'autoPostRuns', 'autoPostWorkouts', 'audioCues',
        'runMode', 'weeklyRunDaysTarget', 'raceGoal', 'weekSchedule',
        'weekScheduleVersion',
        'weeklyRunsTarget', 'age', 'sex', 'activityLevel', 'macroTargets',
        'targetFiber', 'targetSugar', 'targetSodium', 'targetWaterGlasses',
        'enableRolloverCalories', 'autoPostBadges', 'customCalorieTarget',
        'createdAt', 'updatedAt', 'photoURL', 'stallPopupCooldowns', 'shoes', 'lastActiveAt',
        'mealReminders', 'privacyZones', 'stepGoal', 'phaseMode', 'trainingPhase',
        'gender', 'ageRange', 'primaryGoal', 'experience', 'daysPerWeek',
        'equipment', 'preferredSplit', 'runFrequency', 'injuries', 'crewId',
        'adjustCaloriesForTraining',
        'trialExpiryPromptShown',
        'appleOriginalTransactionId', 'appleProductId', 'subscriptionExpiresAt'
      ];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !isDeleting(uid)
        && request.resource.data.keys().hasOnly(allowedUserFields())
        && request.resource.data.subscriptionTier == 'free';
      allow update: if isOwner(uid)
        && !isDeleting(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUserFields())
        && subscriptionFieldsUnchanged();
      allow delete: if isOwner(uid);
    }

    // User subcollections — meals, workouts, runs, weights, water, bodyweight
    // R1A-Deletion: writes frozen while accountDeletionRequests/{uid} is active.
    // Reads remain allowed so the deletion-in-progress UI can render.
    match /users/{uid}/meals/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/savedRoutines/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/workouts/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/runs/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/weights/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/settings/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/foodFavourites/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/waterLog/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/bodyweightLogs/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/programState/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/streaks/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    /* Performance data — written ONLY by Cloud Functions
       (computeAndWritePerformanceForUser in functions/index.js writes
       to users/{uid}/performance/{weekKey}). Path was previously named
       "performanceWeeks" in this rules file but the code (server +
       client) actually uses "performance" — meaning every client
       read of TrajectoryCard / Home performance widgets was denied
       by the catch-all and fell silently to empty state. Renamed to
       match the real collection name. */
    match /users/{uid}/performance/{doc} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ========================================
    // Latent subcollections — owner-only, write-frozen during deletion
    // ========================================
    match /users/{uid}/shoes/{shoeId} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/logs/{date} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }
    match /users/{uid}/stats/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Public profile projection — cross-user readable
    //
    // A deliberately small projection of the user doc's safe fields.
    // Written alongside the main user doc during onboarding, profile
    // update, and streak mutation. Any authenticated user can read;
    // owner-only write with a strict field allowlist — if you need
    // to add a field, extend both this allowlist AND the mirror-write
    // call sites in the same PR.
    // ========================================
    match /users/{uid}/public/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwnerAndNotDeleting(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'photoStoragePath',
          'athleteType',
          'currentStreak',
          'longestStreak',
          'createdAt',
          'badgeSummary'
        ])
        /* photoURL value gate.
           Blocks tracking-pixel injection / arbitrary external URLs.
           Allowed:
           - field absent (partial update without touching photoURL)
           - null or empty string (no photo / removal — both are real
             states; null is what createDefaultProfile writes for
             email signups before any upload, '' is what removeProfilePhoto
             writes when the user clears their custom upload)
           - own-bucket Firebase Storage URLs (custom uploads)
           - Google OAuth CDN (lh3.googleusercontent.com)
           - Apple OAuth CDN (appleid.cdn-apple.com)
           The null check has to come BEFORE any `.matches()` call —
           in Firestore rules `null.matches(...)` is an evaluation
           error, not a falsy short-circuit, so the order matters. */
        && (
          !('photoURL' in request.resource.data)
          || request.resource.data.photoURL == null
          || request.resource.data.photoURL == ''
          || request.resource.data.photoURL.matches('^https://firebasestorage\\.googleapis\\.com/.*')
          || request.resource.data.photoURL.matches('^https://lh3\\.googleusercontent\\.com/.*')
          || request.resource.data.photoURL.matches('^https://appleid\\.cdn-apple\\.com/.*')
        )
        /* photoStoragePath gate — must point to the owner's own
           profile-photos folder. Prevents writing a value that would
           trick the cleanup path into deleting someone else's blob.
           Same null-before-matches ordering as above; null is the
           legitimate state for OAuth-only users (we don't host their
           photo) and for cleared photos. */
        && (
          !('photoStoragePath' in request.resource.data)
          || request.resource.data.photoStoragePath == null
          || request.resource.data.photoStoragePath == ''
          || request.resource.data.photoStoragePath.matches('^profile-photos/' + uid + '/.*')
        );
    }

    // Collection-group read access: user search (`searchUsers`) runs a
    // collectionGroup('public') query with a `displayName` range filter.
    // Firestore evaluates CG queries against rules that cover the leaf
    // collection at ANY depth, so we need this recursive-wildcard rule
    // in addition to the per-user rule above. The per-user rule still
    // enforces owner-only writes; this one only grants read.
    match /{path=**}/public/{doc} {
      allow read: if request.auth != null;
    }

    // ========================================
    // Social: Activities (public feed)
    //
    // H7: authorId must match authenticated user on create. Updates
    // are split into two permitted shapes:
    //
    //   (a) Owner edits — only visibility can change post-creation.
    //       authorId / authorName / authorPhotoURL / createdAt are
    //       immutable once the activity is posted.
    //   (b) Any authenticated user can bump kudosCount / commentCount
    //       via `increment()` from toggleKudos / addComment — but they
    //       can ONLY touch those two fields, never rewrite author
    //       metadata or the activity body.
    //
    // Pre-W1f this allowed any owner update with no field allowlist,
    // which let clients rewrite authorName / visibility / kudosCount
    // / commentCount freely.
    // ========================================
    // ========================================
    // Social: Activity feed posts
    //
    // 2026-05-26 audit findings #1 + #7 + #11 — activity contract
    // hardening. Three properties pinned by `firestore.rules.test.ts`:
    //
    //   (a) Reads are VISIBILITY-AWARE. Pre-2026-05-26 this allowed
    //       any authed user to query the entire `/activities`
    //       collection, including private + followers-only docs.
    //       Now: public is read by any authed; followers-only is
    //       read by owner + actual followers; private is owner-only.
    //
    //   (b) Creates enforce a STRICT FIELD ALLOWLIST + enums + value
    //       bounds + size caps. Pre-audit any field could be written
    //       with any value — pathological payloads (10K-point GPS
    //       arrays, negative distances, junk visibility values)
    //       were accepted.
    //
    //   (c) Update + delete contracts unchanged from W1f. Counter
    //       value validation (#2 — kudos/comment increments-only)
    //       is a separate PR; this audit explicitly defers it.
    //
    // Field allowlist mirrors the postActivity write in
    // src/lib/socialApi.ts. Adding a new field there requires adding
    // it here too — fail-closed by design (unknown field rejects the
    // whole write).
    // ========================================
    match /activities/{activityId} {
      allow read: if request.auth != null && (
        // Public — any authed user
        resource.data.visibility == 'public'
        // Owner — always
        || resource.data.authorId == request.auth.uid
        // Followers-only — read iff caller is a follower of the author
        || (
          resource.data.visibility == 'followers'
          && exists(/databases/$(database)/documents/followers/$(resource.data.authorId)/users/$(request.auth.uid))
        )
      );

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        // Field allowlist — fail-closed; adding a field to
        // postActivity requires adding it here too.
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhotoURL',
          'type', 'visibility',
          'createdAt', 'kudosCount', 'commentCount',
          'workoutName', 'runName', 'activityTitle',
          'exerciseCount', 'totalVolume', 'duration',
          'distance', 'avgPace', 'elevationGain', 'calories',
          'muscleGroups', 'exercises',
          'prHit', 'prExercise', 'prWeight', 'prCount',
          'challengeMilestone', 'badgeEarned', 'crewId',
          'routePreview'
        ])
        // Required fields + types
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.type in ['run', 'workout']
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.kudosCount == 0
        && request.resource.data.commentCount == 0
        // Payload size caps — pathological payload prevention
        && (
          !('routePreview' in request.resource.data.keys())
          || request.resource.data.routePreview.size() <= 5000
        )
        && (
          !('exercises' in request.resource.data.keys())
          || request.resource.data.exercises.size() <= 100
        )
        && (
          !('muscleGroups' in request.resource.data.keys())
          || request.resource.data.muscleGroups.size() <= 20
        )
        // Numeric bounds — when present, must be in plausible range
        && (
          !('distance' in request.resource.data.keys())
          || (request.resource.data.distance >= 0
              && request.resource.data.distance <= 500000)  // 500 km — covers ultras
        )
        && (
          !('duration' in request.resource.data.keys())
          || (request.resource.data.duration >= 0
              && request.resource.data.duration <= 86400)  // 24 h
        )
        && (
          !('elevationGain' in request.resource.data.keys())
          || (request.resource.data.elevationGain >= 0
              && request.resource.data.elevationGain <= 20000)  // 20 km vertical
        )
        && (
          !('calories' in request.resource.data.keys())
          || (request.resource.data.calories >= 0
              && request.resource.data.calories <= 50000)  // ultra-endurance ceiling
        )
        && (
          !('totalVolume' in request.resource.data.keys())
          || (request.resource.data.totalVolume >= 0
              && request.resource.data.totalVolume <= 1000000)  // 1M kg per session is plenty
        )
        && (
          !('exerciseCount' in request.resource.data.keys())
          || (request.resource.data.exerciseCount >= 0
              && request.resource.data.exerciseCount <= 200)
        )
        && (
          !('prWeight' in request.resource.data.keys())
          || (request.resource.data.prWeight >= 0
              && request.resource.data.prWeight <= 1000)
        )
        && (
          !('prCount' in request.resource.data.keys())
          || (request.resource.data.prCount >= 0
              && request.resource.data.prCount <= 1000)
        )
        // String length caps
        && (
          !('workoutName' in request.resource.data.keys())
          || request.resource.data.workoutName.size() <= 200
        )
        && (
          !('runName' in request.resource.data.keys())
          || request.resource.data.runName.size() <= 200
        )
        && (
          !('activityTitle' in request.resource.data.keys())
          || request.resource.data.activityTitle.size() <= 200
        )
        && (
          !('prExercise' in request.resource.data.keys())
          || request.resource.data.prExercise.size() <= 200
        )
        && (
          !('challengeMilestone' in request.resource.data.keys())
          || request.resource.data.challengeMilestone.size() <= 200
        )
        && (
          !('badgeEarned' in request.resource.data.keys())
          || request.resource.data.badgeEarned.size() <= 200
        )
        && (
          !('crewId' in request.resource.data.keys())
          || request.resource.data.crewId.size() <= 200
        );

      // Update contract unchanged from W1f. Counter value validation
      // (audit finding #2 — increments-only) is deferred to PR 2.
      allow update: if request.auth != null && (
        // Owner: can only touch visibility post-creation.
        (resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['visibility']))
        // Non-owner: kudosCount / commentCount field-set restricted.
        // Value validation (audit #2) deferred to PR 2.
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['kudosCount', 'commentCount']))
      );
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // ========================================
    // Challenges — global, auto-seeded by seedChallenges() on the
    // client.
    //
    // PR K (audit P1 #11): pre-PR-K this allowed `write: if
    // request.auth != null` — any authed user could create junk
    // docs with arbitrary IDs OR overwrite existing entries with
    // poisoned payloads (the seedChallenges idempotent guard
    // protected against the legitimate-client path but couldn't
    // stop a malicious caller). The replacement:
    //
    //   - Reads stay open to any authed user (global metadata).
    //   - Creates require the docId to match one of the five
    //     known seed prefixes used by seedChallenges():
    //       weekly-     · weekly workout challenge
    //       monthly-    · monthly mileage / equivalent
    //       seasonal-   · seasonal challenge (rotates)
    //       fastest-5k- · pace-based monthly challenge
    //       group-goal- · collective monthly target
    //     Random-ID junk is now denied. New prefixes added to
    //     seedChallenges() must be allowlisted here too — fail-
    //     closed by design.
    //   - Updates + deletes are locked to admin SDK. The client
    //     seedChallenges path only writes when !exists, so it
    //     never needs update permissions — closing this off
    //     means a compromised client can't corrupt an existing
    //     challenge document.
    //
    // Participant docs: read by any authed user (leaderboard reads
    //   need to see other people's progress); write only by the
    //   participant themselves.
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (
          challengeId.matches('weekly-.*')
          || challengeId.matches('monthly-.*')
          || challengeId.matches('seasonal-.*')
          || challengeId.matches('fastest-5k-.*')
          || challengeId.matches('group-goal-.*')
        );
      allow update, delete: if false;

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ========================================
    // Social: Feeds — user can only read/write their own feed
    //
    // Feed writes happen during fan-out from postActivity — the
    // poster writes a feed item into each follower's /feeds/{followerUid}/items
    // collection. Pre-W1f the create rule allowed any authenticated
    // user to push arbitrary docs into any other user's feed. Now
    // the inserted doc must carry an authorId equal to the writer's
    // auth.uid, so user A can only fan out their OWN activities —
    // no impersonating user C into user B's feed.
    // ========================================
    match /feeds/{uid}/items/{doc} {
      allow read: if isOwner(uid);
      // R1A-Deletion: feed-item creation freezes when EITHER the feed
      // owner (recipient) OR the writer (poster) is being deleted —
      // the rule already enforces writer = authorId, so checking
      // !isDeleting(uid) (feed owner) AND !isDeleting(request.auth.uid)
      // (poster) covers both. Self-fan-out (writer == owner) is also
      // gated.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && !isDeleting(uid)
        && !isDeleting(request.auth.uid);
      allow delete: if isOwner(uid);
    }

    // ========================================
    // Social: Kudos
    // H7: userId (doc ID) must match authenticated user
    // ========================================
    match /kudos/{activityId}/users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // ========================================
    // Social: Comments
    //
    // H7: authorId must match authenticated user on create. Pre-W1f
    // the delete rule was missing entirely, which meant the client-
    // side deleteComment (guarded by a JS check against author) was
    // always hitting permission-denied and silently failing — users
    // couldn't actually delete their own comments. Added explicit
    // delete rule that enforces the same "author only" policy
    // server-side.
    // ========================================
    match /comments/{activityId}/items/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // ========================================
    // Social: Following / Followers
    // H7: only the owner of the follow relationship can manage it
    // ========================================
    match /following/{uid}/users/{targetUid} {
      allow read: if request.auth != null;
      // R1A-Deletion: freeze writes when either side is deleting.
      // Owner (uid) is the user managing their own follow list;
      // targetUid is the user being followed/unfollowed — both must
      // be writable.
      allow create, delete: if isOwnerAndNotDeleting(uid)
        && !isDeleting(targetUid);
    }

    match /followers/{uid}/users/{followerUid} {
      allow read: if request.auth != null;
      // Follower doc is written by the person doing the following.
      // R1A-Deletion: writer (followerUid) and recipient (uid) both
      // must be writable.
      allow create, delete: if request.auth != null
        && request.auth.uid == followerUid
        && !isDeleting(followerUid)
        && !isDeleting(uid);
    }

    // ========================================
    // Social: Notifications — owner-only read
    //
    // Pre-W1f any authenticated user could write any notification
    // for any other user with any content — impersonation surface.
    // Now the created doc must have `fromUserId == auth.uid` so
    // spam / impersonation notifications ("Tropos: you owe us $500")
    // can't be forged. Kudos / comment / follow notifications from
    // writeNotification() already set fromUserId to the sender.
    //
    // Update is not permitted from clients — notifications are
    // immutable once written (the `read` flag is flipped via delete
    // + replace rather than mutation).
    // ========================================
    match /notifications/{uid}/items/{doc} {
      allow read, delete: if isOwner(uid);
      // R1A-Deletion: freeze writes when either fromUserId (writer)
      // or uid (recipient) is being deleted.
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid
        && !isDeleting(request.auth.uid)
        && !isDeleting(uid);
    }

    // ========================================
    // Social: Blocks — owner manages their own block list
    // ========================================
    match /blocks/{uid}/users/{targetUid} {
      allow read: if isOwner(uid);
      // R1A-Deletion: writes frozen during owner's deletion. targetUid
      // deletion is NOT a freeze condition — a user can still block /
      // unblock someone whose account is mid-deletion (locally
      // applied, the executor cleans the doc).
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Reports — any authenticated user can create, no client reads
    // ========================================
    match /reports/{reportId} {
      // R1A-Deletion: deleting users cannot file new reports. Existing
      // reports they filed are anonymised by the executor; in-flight
      // reports during the deletion window are blocked here.
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && !isDeleting(request.auth.uid);
      allow read, update, delete: if false;
    }

    // ========================================
    // Crews (stored at /groups/... — client code reads/writes
    // `collection(db, 'groups')` via useCrews; the "crew" vs "group"
    // naming is a UI-level synonym)
    //
    // Pre-W1f the rules pointed at /crews/ while the code hit
    // /groups/ — every crew create / join / leave was silently
    // default-denied and the crew feature never worked server-side.
    // Renaming here to match the collection the app actually uses.
    //
    // Create path requires `createdBy == auth.uid` so attackers can't
    // attribute new crews to other users (which would then give the
    // attributed user update/delete authority over an unwanted crew).
    //
    // Update also tightened: increments to `memberCount` happen on
    // join/leave by the member themselves, so we allow non-creator
    // updates ONLY when the write affects `memberCount` alone.
    // ========================================
    match /groups/{crewId} {
      allow read: if request.auth != null;
      // R1A-Deletion: deleting users cannot create new crews. Updates
      // (including memberCount bumps) are also frozen for the actor
      // when they're being deleted — the executor handles cleanup
      // including memberCount decrement.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && !isDeleting(request.auth.uid);
      allow update: if request.auth != null
        && !isDeleting(request.auth.uid)
        && (
          // Creator can edit any field on the crew they made.
          resource.data.createdBy == request.auth.uid
          // Any authed user can bump memberCount (join/leave flow).
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberCount'])
        );
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ========================================
    // Crew members — authenticated read, self-write, write-frozen during deletion
    // ========================================
    match /groups/{crewId}/members/{userId} {
      allow read: if request.auth != null;
      // R1A-Deletion: a deleting user cannot join new crews. Leaving
      // a crew (delete) remains allowed even during deletion so the
      // executor's per-member cleanup can use the same delete path.
      // However the executor uses Admin SDK which bypasses rules
      // entirely; the rule here protects against client-driven
      // races mid-deletion.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && !isDeleting(userId);
      allow delete: if request.auth != null
        && (request.auth.uid == userId
            || get(/databases/$(database)/documents/groups/$(crewId)).data.createdBy == request.auth.uid);
    }

    // ========================================
    // User subcollection: Progress photos — owner-only
    // ========================================
    match /users/{uid}/progressPhotos/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // User subcollection: GPS privacy zones — owner-only, write-frozen during deletion.
    match /users/{uid}/privacyZones/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwnerAndNotDeleting(uid);
    }

    // ========================================
    // Scan usage — food-scan quota tracker.
    // Written exclusively by Cloud Functions (analyzeFood /
    // analyzeFoodText use Admin SDK to bump the count); the client
    // reads it via useScanUsage to render the quota indicator.
    // Without this rule the read was denied by the catch-all and
    // the quota indicator silently fell back to "0 used".
    // ========================================
    match /scanUsage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ========================================
    // User subcollection: Client error reports
    //
    // errorReporting.persistToFirestore writes critical errors (network,
    // component, payment/auth/subscription keyword matches) here. Without
    // this rule, writes silently fail against the default-deny and the
    // error log never materialises. Create-only from the client so a
    // compromised session can't rewrite its own history; reads are
    // reserved for Admin-SDK support tooling.
    // ========================================
    match /users/{uid}/errors/{doc} {
      allow create: if isOwnerAndNotDeleting(uid);
      allow read, update, delete: if false;
    }

    // ========================================
    // Server-managed feature flags
    //
    // Holds kill switches the app and Cloud Functions read at runtime —
    // e.g. `geminiEnabled` to instantly cut AI food/text analysis off
    // if costs spike or Gemini is down. World-readable (any
    // authenticated client needs to see the flag before a scan) and
    // write-only from Admin-SDK / Firebase Console.
    // ========================================
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ========================================
    // ========================================
    // Audit: successful Stripe Checkout session creations
    //
    // Written exclusively by the createCheckoutSession Cloud Function
    // (Admin SDK) — never by clients. The default-deny rule at the
    // top of this file already covers it; this explicit block is here
    // to document the intent so a future "let me make this readable
    // for the dashboard" instinct hits a clear no first. Admin SDK
    // bypasses these rules so the function's writes work regardless.
    //
    // Schema lives in functions/auditLog.js — see
    // CHECKOUT_AUDIT_COLLECTION / buildCheckoutAuditEntry.
    // ========================================
    match /audit_checkout_sessions/{doc} {
      allow read, write: if false;
    }

    // ========================================
    // R1A-Deletion operational collections
    //
    // Server-written via Admin SDK only. Clients can read their own
    // ledger doc so the AccountSection UI can render the in-progress
    // / failed / pending state durably (the Chunk 4 reauth UX depends
    // on this read path). All other collections are server-only.
    // ========================================
    match /accountDeletionRequests/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /deletedAccounts/{uid} {
      // Tombstone is for system-writer guards (Admin SDK reads only).
      // Clients have no legitimate need to read or write this.
      allow read, write: if false;
    }

    match /deletedBillingIdentities/{identifierHash} {
      // Hashed billing-identifier tombstone for webhook guards.
      // Server-only.
      allow read, write: if false;
    }

    match /paymentEventsPostDeletion/{eventId} {
      // Webhook log for payment events targeting tombstoned accounts.
      // Operator review only; Admin SDK reads.
      allow read, write: if false;
    }

    // ========================================
    // Restricted-user marker (S4e lock — PR #722).
    //
    // Single doc per restricted UID. The doc's mere existence
    // signals "this user is currently restricted from social
    // actions" (Find-tab search/follow/invite). Schema per S4e
    // critical implication (1): { uid, restrictedAt,
    // restrictionEndsAt: null, lastActionedReport, strikes: null }.
    // strikes/restrictionEndsAt null on manual restriction; future
    // S4d-full auto-strike CF populates them.
    //
    // Reads: own-doc only — the user can read their own restriction
    // state for the UI gate. No cross-user discovery: rules-deny on
    // any uid != request.auth.uid.
    //
    // Writes: Admin SDK only via the resolveReport callable's
    // restrictUser option. Direct client writes denied.
    // ========================================
    match /globalRestrictedUids/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
