{
  "name": "tropos",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode=test",
    "build:ios": "CAPACITOR_BUILD=true tsc -b && CAPACITOR_BUILD=true vite build && npx cap sync ios",
    "build:android": "CAPACITOR_BUILD=true tsc -b && CAPACITOR_BUILD=true vite build && npx cap sync android",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run firestore.rules.test.ts'",
    "seed:e2e": "tsx scripts/seed-e2e-user.ts",
    "seed:rich": "tsx scripts/seed-rich-user.ts",
    "seed:default-crews": "tsx scripts/seed-default-crews.ts",
    "backfill:streak-mirror": "tsx scripts/backfill-streak-mirror.ts",
    "prepare": "husky",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.2.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@stripe/stripe-js": "^8.7.0",
    "@zxing/browser": "^0.1.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cordova-plugin-purchase": "^13.16.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.14.0",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "leo-profanity": "^1.9.0",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.19.0",
    "react": "^19.2.6",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource/barlow-semi-condensed": "^5.2.7",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.10.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "react-doctor": "^0.2.16",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
