# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Local env files — never commit secrets. `.env.example` is the tracked
# template; everything else (.env, .env.local, .env.production, …) is ignored.
.env
.env.*
!.env.example
*.local

# Cloud Functions runtime-config dump (`firebase functions:config:get > .runtimeconfig.json`)
functions/.runtimeconfig.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Council reports (local reference only)
council-report-*.html
council-transcript-*.md
council-verdict-*.md

# Playwright test artefacts (generated by `npx playwright test`)
playwright-report/
test-results/
playwright/.cache/

# Claude Code agent worktrees (Agent tool isolation — never committed)
.claude/worktrees/
public/exercise-demos/_preview.html

# Local Playwright capture-run output (CI owns the app-screenshots branch;
# the local dir is generated noise — CI force-adds with -f)
/screenshots/

# graphify output — generated knowledge graph (rebuildable via /graphify .);
# untracked so a build never trips the closeout stop-hook. Remove to commit it.
graphify-out/

# Ad-hoc agent worktrees created INSIDE the repo (mutation checks, parallel
# verification). `.claude/worktrees/` above covers the managed ones; these are
# named per-task (wt-mut, wt-flush, ...) and a `git add -A` will happily commit
# one as an embedded git repository. That happened, so this is not theoretical.
/wt-*/
