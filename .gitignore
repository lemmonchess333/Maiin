# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Local env files — never commit secrets. `.env.example` is the tracked
# template; everything else (.env, .env.local, .env.production, …) is ignored.
.env
.env.*
!.env.example
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Council reports (local reference only)
council-report-*.html
council-transcript-*.md
council-verdict-*.md

# Playwright test artefacts (generated by `npx playwright test`)
playwright-report/
test-results/
playwright/.cache/

# Claude Code agent worktrees (Agent tool isolation — never committed)
.claude/worktrees/

# Local Playwright capture-run output (CI owns the app-screenshots branch;
# the local dir is generated noise — CI force-adds with -f)
screenshots/
