rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 2026-05-26 audit PR 4 (finding #8) — MIME allowlist.
    // Pre-PR-4 `image/.*` accepted `image/svg+xml`. SVGs can carry
    // inline `<script>` payloads that execute if ever rendered
    // inline (e.g. via direct DOM injection rather than `<img src>`).
    // Tropos's current render paths all use `<img src>` which sandboxes
    // the SVG, but the rule was a future-proof / defense-in-depth gap:
    // a template change three years from now that drops a profile
    // avatar into an `<svg>` inline-include would resurrect the XSS
    // surface. Closed-set MIME types remove the risk class entirely.
    //
    // raster-only formats are sufficient for both surfaces:
    //   - Progress photos: real camera / gallery output
    //   - Profile photos: OAuth provider thumbnails (Google / Apple
    //     return JPEG; client-resized uploads are JPEG / PNG / WEBP)
    function isAllowedImageMime() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Packet 11 — account-deletion write freeze for Storage.
    // Firestore Rules already freeze writes while an account deletion is
    // active (accountDeletionRequests) and after it completes
    // (deletedAccounts tombstone). Storage did NOT consult either, so a
    // valid-but-stale session could keep uploading/overwriting/deleting
    // blobs until the ID token expired. This mirrors that freeze.
    //
    // Cross-service reads use the LITERAL Firestore database name `(default)`
    // (Storage Rules have no `database` variable). The active-status set
    // matches the firestore.rules isDeleting() set exactly.
    function isDeletionWriteFrozen(uid) {
      let requestPath =
        /databases/(default)/documents/accountDeletionRequests/$(uid);
      let tombstonePath =
        /databases/(default)/documents/deletedAccounts/$(uid);

      return firestore.exists(tombstonePath)
        || (
          firestore.exists(requestPath)
          && firestore.get(requestPath).data.status in [
            'running',
            'failed_cleanup',
            'pending_cleanup',
            'pending_auth_deletion',
            'operator_review'
          ]
        );
    }

    function isOwnerAndWritable(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && !isDeletionWriteFrozen(uid);
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Progress photos — owner-only access
    match /progress-photos/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isOwnerAndWritable(uid)
        && request.resource.size < 10 * 1024 * 1024
        && isAllowedImageMime();
      allow delete: if isOwnerAndWritable(uid);
    }

    // Food diary photos — owner-only access (same posture as progress
    // photos: the diary is private). Blobs live for the meal doc's
    // lifetime (meal deletion is SOFT — 24h restore — so no delete-on-
    // delete); the account-deletion executor sweeps the whole prefix.
    match /food-photos/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isOwnerAndWritable(uid)
        && request.resource.size < 10 * 1024 * 1024
        && isAllowedImageMime();
      allow delete: if isOwnerAndWritable(uid);
    }

    // Community Space post photos (Spc1 PR4) — owner-only write,
    // AUTHENTICATED read: space posts are visible to every signed-in
    // user (all spaces are open topic rooms), so their photos share
    // the profile-photos read posture, not the private diary one.
    // Blobs live for the post's lifetime; the account-deletion
    // executor sweeps the whole prefix (spacePhotosStorage).
    match /space-photos/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwnerAndWritable(uid)
        && request.resource.size < 10 * 1024 * 1024
        && isAllowedImageMime();
      allow delete: if isOwnerAndWritable(uid);
    }

    // Profile photos — owner-only write, authenticated read
    match /profile-photos/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwnerAndWritable(uid)
        && request.resource.size < 5 * 1024 * 1024
        && isAllowedImageMime();
      allow delete: if isOwnerAndWritable(uid);
    }
  }
}
